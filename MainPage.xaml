<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:loc="clr-namespace:yChicaTube.Localization"
             x:Class="yChicaTube.MainPage" 
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

  <Grid x:Name="MainGrid" RowDefinitions="Auto,*,Auto" Padding="0" RowSpacing="0">
    
    <!-- ========================================== -->
    <!-- 1. CABEÇALHO COMPACTO & LÚDICO (52-56dp) -->
    <!-- ========================================== -->
    <Grid x:Name="HeaderView" 
          ColumnDefinitions="*,Auto" 
          HeightRequest="60" 
          Padding="16,8" 
          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}">
      
      <!-- Marca yChicaTube -->
      <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                StrokeThickness="0" 
                StrokeShape="RoundRectangle 18" 
                HeightRequest="42" 
                WidthRequest="42" 
                VerticalOptions="Center">
          <Label Text="🐥" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
        
        <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
          <Label Text="yChica" 
                 FontSize="22" 
                 FontAttributes="Bold" 
                 TextColor="{AppThemeBinding Light={StaticResource BrandGreenDark}, Dark={StaticResource BrandGreenLight}}" 
                 VerticalOptions="Center" />
          <Label Text="Tube" 
                 FontSize="22" 
                 FontAttributes="Bold" 
                 TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                 VerticalOptions="Center" />
        </HorizontalStackLayout>

        <Label x:Name="SubtitleLabel" 
               Text="{loc:Translate AppSubtitle}" 
               FontSize="12" 
               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
               VerticalOptions="Center" 
               Margin="6,2,0,0" 
               LineBreakMode="TailTruncation" />
      </HorizontalStackLayout>

      <!-- Botão de Acesso de Adultos -->
      <Button x:Name="HeaderParentsBtn"
              Grid.Column="1" 
              Text="{loc:Translate BtnParents}"
              Clicked="OnParentsClicked" 
              BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
              TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
              BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
              BorderWidth="1.5" 
              CornerRadius="20" 
              HeightRequest="42" 
              Padding="16,0" 
              FontAttributes="Bold" 
              FontSize="13" 
              VerticalOptions="Center" />
    </Grid>

    <!-- Linha divisória subtil abaixo do cabeçalho -->
    <BoxView Grid.Row="0" 
             HeightRequest="1" 
             BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
             VerticalOptions="End" />

    <!-- ========================================== -->
    <!-- 2. FEED PRINCIPAL (ADAPTATIVO: PHONE/TABLET/TV) -->
    <!-- ========================================== -->
    <Grid Grid.Row="1" BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">
      <Grid x:Name="LibraryView" RowDefinitions="Auto,Auto,*" Padding="12,6,12,6">
        
        <!-- Dica de Comando de TV (Visível apenas na TV) -->
        <Border x:Name="TvRemoteHintBanner" 
                Grid.Row="0"
                IsVisible="False" 
                BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                Stroke="{StaticResource BrandGreen}" 
                StrokeThickness="1.5" 
                StrokeShape="RoundRectangle 14" 
                Padding="14,8" 
                Margin="0,0,0,4" 
                HorizontalOptions="Center">
          <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
            <Label Text="📺" FontSize="16" VerticalOptions="Center" />
            <Label Text="{loc:Translate TvRemoteHintText}" 
                   FontSize="13" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light={StaticResource BrandGreenDark}, Dark={StaticResource BrandGreenLight}}" 
                   VerticalOptions="Center" />
          </HorizontalStackLayout>
        </Border>

        <!-- BARRA DE TEMAS PERMITIDOS PARA A CRIANÇA (SEMPRE FIXA NO TOPO / STICKY) -->
        <Border x:Name="ChildThemesBarContainer" 
                Grid.Row="1"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}" 
                StrokeThickness="0" 
                Padding="0,2,0,6" 
                Margin="0">
          <CollectionView x:Name="ChildThemesList" 
                          ItemsLayout="HorizontalList" 
                          SelectionMode="None" 
                          HeightRequest="42">
            <CollectionView.ItemTemplate>
              <DataTemplate>
                <Border StrokeShape="RoundRectangle 20" 
                        StrokeThickness="2" 
                        Padding="14,0" 
                        Margin="0,0,8,0" 
                        HeightRequest="38" 
                        VerticalOptions="Center">
                  <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                      <Setter Property="BackgroundColor" Value="{StaticResource BrandGreen}" />
                      <Setter Property="Stroke" Value="{StaticResource BrandGreenDark}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                      <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" />
                      <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                    </DataTrigger>
                  </Border.Triggers>
                  <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChildThemeChipTapped" CommandParameter="{Binding .}" />
                  </Border.GestureRecognizers>
                  <Label Text="{Binding Name}" 
                         FontAttributes="Bold" 
                         FontSize="13" 
                         VerticalOptions="Center" 
                         HorizontalOptions="Center" 
                         InputTransparent="True">
                    <Label.Triggers>
                      <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource White}" />
                      </DataTrigger>
                      <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                      </DataTrigger>
                    </Label.Triggers>
                  </Label>
                </Border>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>
        </Border>

        <!-- ÁREA PRINCIPAL DE VÍDEOS -->
        <Grid Grid.Row="2">
          <!-- GRELHA DE VÍDEOS (ADAPTATIVA COM SCROLL INDEPENDENTE) -->
          <CollectionView x:Name="VideoList" SelectionMode="Single" SelectionChanged="OnVideoSelectionChanged">
            <CollectionView.ItemsLayout>
              <GridItemsLayout x:Name="VideoListLayout" Orientation="Vertical" Span="1" HorizontalItemSpacing="14" VerticalItemSpacing="14" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
              <DataTemplate>
                <Border Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                        StrokeShape="RoundRectangle 18" 
                        StrokeThickness="1.5"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                        Margin="0,0,0,4" 
                        Padding="0">
                  <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPlayCardTapped" CommandParameter="{Binding .}" />
                  </Border.GestureRecognizers>
                  
                  <VerticalStackLayout Spacing="0" InputTransparent="True">
                    <!-- Thumbnail 16:9 Limpa e Nítida -->
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            HeightRequest="195" 
                            HorizontalOptions="Fill" 
                            InputTransparent="True">
                      <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True" />
                    </Border>

                    <!-- Detalhes do Vídeo: Título Nítido, Badge Temático e Indicador Lúdico -->
                    <Grid ColumnDefinitions="*,Auto" Padding="14,12" InputTransparent="True" VerticalOptions="Center">
                      <VerticalStackLayout Spacing="6" VerticalOptions="Center" InputTransparent="True">
                        <Label Text="{Binding Title}" 
                               FontAttributes="Bold" 
                               FontSize="15" 
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                               LineBreakMode="TailTruncation" 
                               MaxLines="2" 
                               InputTransparent="True" />
                        
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center" InputTransparent="True">
                          <!-- Badge do Modo / Tema -->
                          <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                                  StrokeThickness="0" 
                                  StrokeShape="RoundRectangle 10" 
                                  Padding="8,4" 
                                  VerticalOptions="Center"
                                  InputTransparent="True">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center" InputTransparent="True">
                              <Label Text="{Binding BadgeIcon}" FontSize="12" VerticalOptions="Center" InputTransparent="True" />
                              <Label Text="{Binding BadgeText}" 
                                     FontSize="12" 
                                     TextColor="{Binding BadgeColor}" 
                                     FontAttributes="Bold" 
                                     VerticalOptions="Center" 
                                     InputTransparent="True" />
                            </HorizontalStackLayout>
                          </Border>

                          <!-- Badge Seguro -->
                          <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                                  StrokeThickness="1" 
                                  Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                                  StrokeShape="RoundRectangle 10" 
                                  Padding="8,4" 
                                  VerticalOptions="Center"
                                  InputTransparent="True">
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center" InputTransparent="True">
                              <Label Text="🛡️" FontSize="11" VerticalOptions="Center" InputTransparent="True" />
                              <Label Text="Sem Anúncios" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" VerticalOptions="Center" InputTransparent="True" />
                            </HorizontalStackLayout>
                          </Border>
                        </HorizontalStackLayout>
                      </VerticalStackLayout>

                      <!-- Botão Lúdico Lateral Assistir -->
                      <Border Grid.Column="1" 
                              BackgroundColor="{StaticResource BrandGreen}" 
                              StrokeThickness="0" 
                              StrokeShape="RoundRectangle 20" 
                              HeightRequest="40" 
                              WidthRequest="40" 
                              HorizontalOptions="Center" 
                              VerticalOptions="Center" 
                              Margin="8,0,0,0"
                              InputTransparent="True">
                        <Label Text="▶" TextColor="White" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center" Margin="2,0,0,0" InputTransparent="True" />
                      </Border>
                    </Grid>
                  </VerticalStackLayout>
                </Border>
              </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Rodapé da Lista (Descoberta & Badge) -->
            <CollectionView.Footer>
              <VerticalStackLayout Spacing="8" Padding="0,10,0,20">
                <!-- Botão de Descoberta para a Criança -->
                <VerticalStackLayout x:Name="DiscoverMoreContainer" IsVisible="False" Spacing="6" Margin="0,4,0,4">
                  <Button x:Name="DiscoverMoreBtn" 
                          Text="{loc:Translate BtnDiscoverMoreStories}" 
                          Clicked="OnDiscoverMoreClicked" 
                          BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                          TextColor="{AppThemeBinding Light={StaticResource BrandGreenDark}, Dark={StaticResource BrandGreenLight}}" 
                          BorderColor="{AppThemeBinding Light={StaticResource BrandGreen}, Dark={StaticResource BrandGreenLight}}" 
                          BorderWidth="1.5" 
                          FontAttributes="Bold" 
                          CornerRadius="22" 
                          Padding="14,8" 
                          FontSize="13" 
                          HeightRequest="44" 
                          HorizontalOptions="Fill" />
                  <ActivityIndicator x:Name="DiscoverIndicator" IsRunning="False" IsVisible="False" Color="{StaticResource BrandGreen}" HeightRequest="24" />
                </VerticalStackLayout>

                <!-- Distintivo de Segurança Discreto -->
                <Border StrokeThickness="0" 
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                        StrokeShape="RoundRectangle 12" 
                        Padding="12,8" 
                        Margin="0,4,0,0">
                  <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="🛡️" FontSize="13" VerticalOptions="Center" />
                    <Label Text="{loc:Translate SafetyBadge}" 
                           FontSize="11" 
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                           VerticalOptions="Center" />
                  </HorizontalStackLayout>
                </Border>
              </VerticalStackLayout>
            </CollectionView.Footer>
          </CollectionView>

          <!-- Indicador de Carregamento Rápido -->
          <ActivityIndicator x:Name="ChildThemeLoadingIndicator" 
                             IsRunning="False" 
                             IsVisible="False" 
                             Color="{StaticResource BrandGreen}" 
                             HeightRequest="36" 
                             WidthRequest="36" 
                             HorizontalOptions="Center" 
                             VerticalOptions="Center" />

          <!-- Estado Vazio Acolhedor e Compacto (<35% do ecrã) -->
          <Border x:Name="EmptyLabel" 
                  IsVisible="False" 
                  Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                  StrokeShape="RoundRectangle 18" 
                  BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                  Padding="16,20" 
                  Margin="4,12"
                  VerticalOptions="Center"
                  HorizontalOptions="Center">
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
              <Border BackgroundColor="{AppThemeBinding Light={StaticResource AccentAmberSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                      StrokeThickness="0" 
                      StrokeShape="RoundRectangle 28" 
                      HeightRequest="56" 
                      WidthRequest="56" 
                      HorizontalOptions="Center">
                <Label Text="🎬" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
              
              <Label Text="{loc:Translate EmptyStoriesTitle}" 
                     FontSize="16" 
                     FontAttributes="Bold" 
                     TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                     HorizontalTextAlignment="Center" />
              
              <Label Text="{loc:Translate EmptyStoriesDescription}" 
                     FontSize="12" 
                     TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                     HorizontalTextAlignment="Center" 
                     MaximumWidthRequest="300" />

              <Button x:Name="EmptyAdultsBtn" 
                      Text="{loc:Translate BtnOpenAdultArea}" 
                      Clicked="OnParentsClicked" 
                      BackgroundColor="{StaticResource BrandGreen}" 
                      TextColor="{StaticResource White}" 
                      FontAttributes="Bold" 
                      CornerRadius="22" 
                      HeightRequest="44" 
                      Padding="20,0" 
                      Margin="0,6,0,0" 
                      HorizontalOptions="Center" />
            </VerticalStackLayout>
          </Border>
        </Grid>
      </Grid>

      <!-- ========================================== -->
      <!-- 2B. EXPERIÊNCIA DEDICADA ANDROID TV (10-FOOT TV-FIRST UI) -->
      <!-- ========================================== -->
      <Grid x:Name="TvHomeContainer" 
            IsVisible="False" 
            BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=#070C18}"
            RowDefinitions="Auto,*" 
            Padding="48,20,48,24">
        
        <!-- HEADER TV (Elegante, Compacto e Seguro) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center" Margin="0,0,0,16">
          <!-- Logo & Marca TV -->
          <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
            <Border BackgroundColor="#10B981" 
                    StrokeThickness="0" 
                    StrokeShape="RoundRectangle 24" 
                    HeightRequest="48" 
                    WidthRequest="48" 
                    VerticalOptions="Center">
              <Label Text="🐥" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
              <Label Text="yChica" FontSize="26" FontAttributes="Bold" TextColor="#34D399" VerticalOptions="Center" />
              <Label Text="Tube" FontSize="26" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" />
            </HorizontalStackLayout>
          </HorizontalStackLayout>

          <!-- Filtro de Categorias no Topo (Header) -->
          <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
            <HorizontalStackLayout x:Name="TvHeaderCategories" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center" />
          </ScrollView>

          <!-- Botão de Acesso de Adultos TV -->
          <Border x:Name="TvAdultsBtnBorder" 
                  Grid.Column="2" 
                  BackgroundColor="#1E293B" 
                  Stroke="#334155" 
                  StrokeThickness="2" 
                  StrokeShape="RoundRectangle 22" 
                  Padding="18,8" 
                  VerticalOptions="Center">
            <Border.GestureRecognizers>
              <TapGestureRecognizer Tapped="OnParentsClicked" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
              <Label Text="⚙️" FontSize="18" VerticalOptions="Center" />
              <Label Text="{loc:Translate BtnParents}" FontSize="15" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center" />
            </HorizontalStackLayout>
          </Border>
        </Grid>

        <!-- FEED E TRILHOS HORIZONTAIS DA TV -->
        <ScrollView x:Name="TvScrollView" Grid.Row="1" Orientation="Vertical" VerticalScrollBarVisibility="Never">
          <VerticalStackLayout Spacing="28" Padding="0,0,0,40">
            
            <!-- 1. HERO SPOTLIGHT (DESTAQUE CINEMATOGRÁFICO) -->
            <Border x:Name="TvHeroCard" 
                    IsVisible="False" 
                    BackgroundColor="#1E293B" 
                    Stroke="#334155" 
                    StrokeThickness="2.5" 
                    StrokeShape="RoundRectangle 24" 
                    Padding="0" 
                    HeightRequest="290" 
                    HorizontalOptions="Fill">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTvHeroTapped" />
              </Border.GestureRecognizers>
              
              <Grid ColumnDefinitions="460,*" Padding="0">
                <!-- Imagem do Hero 16:9 -->
                <Grid Grid.Column="0">
                  <Image x:Name="TvHeroImage" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" />
                  <BoxView BackgroundColor="#30000000" HorizontalOptions="Fill" VerticalOptions="Fill" />
                  
                  <!-- Badge Flutuante no Topo da Imagem -->
                  <Border BackgroundColor="#E60F172A" 
                          StrokeThickness="0" 
                          StrokeShape="RoundRectangle 12" 
                          Padding="12,6" 
                          Margin="16" 
                          HorizontalOptions="Start" 
                          VerticalOptions="Start">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                      <Label Text="⭐" FontSize="14" VerticalOptions="Center" />
                      <Label x:Name="TvHeroBadgeLabel" Text="{loc:Translate TvFeaturedBadge}" FontSize="13" FontAttributes="Bold" TextColor="#34D399" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                  </Border>
                </Grid>

                <!-- Detalhes do Hero e Botão VER AGORA -->
                <VerticalStackLayout Grid.Column="1" Padding="28,24" Spacing="14" VerticalOptions="Center">
                  <Label x:Name="TvHeroTitleLabel" 
                         Text="Título do Vídeo em Destaque" 
                         FontSize="24" 
                         FontAttributes="Bold" 
                         TextColor="#FFFFFF" 
                         MaxLines="2" 
                         LineBreakMode="TailTruncation" />
                  
                  <Label x:Name="TvHeroSubtitleLabel" 
                         Text="{loc:Translate ApprovedByParents}" 
                         FontSize="15" 
                         TextColor="#94A3B8" />

                  <!-- Botão Focável VER AGORA -->
                  <Border x:Name="TvHeroWatchBtn" 
                          BackgroundColor="#10B981" 
                          Stroke="#34D399" 
                          StrokeThickness="3" 
                          StrokeShape="RoundRectangle 26" 
                          HeightRequest="52" 
                          Padding="24,0" 
                          HorizontalOptions="Start" 
                          VerticalOptions="Center"
                          Margin="0,6,0,0">
                    <Border.GestureRecognizers>
                      <TapGestureRecognizer Tapped="OnTvHeroTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Center">
                      <Label Text="{loc:Translate TvWatchNow}" FontSize="16" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                  </Border>
                </VerticalStackLayout>
              </Grid>
            </Border>

            <!-- 2. RAIL: CONTINUAR A VER / HISTÓRIAS RECENTES -->
            <VerticalStackLayout x:Name="TvContinueRail" Spacing="12">
              <Label Text="{loc:Translate TvContinueWatching}" FontSize="20" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center" />

              <CollectionView x:Name="TvContinueList" 
                              ItemsLayout="HorizontalList" 
                              HeightRequest="255" 
                              SelectionMode="None">
                <CollectionView.ItemTemplate>
                  <DataTemplate>
                    <Border StrokeShape="RoundRectangle 20" 
                            WidthRequest="300" 
                            HeightRequest="225"
                            Margin="4,8,22,14" 
                            Padding="0">
                      <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsTvFocused}" Value="True">
                          <Setter Property="Stroke" Value="{StaticResource TvFocusBorderBrush}" />
                          <Setter Property="StrokeThickness" Value="4" />
                          <Setter Property="Scale" Value="1.08" />
                          <Setter Property="BackgroundColor" Value="{StaticResource TvFocusCardBg}" />
                          <Setter Property="ZIndex" Value="10" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsTvFocused}" Value="False">
                          <Setter Property="Stroke" Value="{StaticResource TvNormalBorderBrush}" />
                          <Setter Property="StrokeThickness" Value="2" />
                          <Setter Property="Scale" Value="1.0" />
                          <Setter Property="BackgroundColor" Value="{StaticResource TvNormalCardBg}" />
                          <Setter Property="ZIndex" Value="1" />
                        </DataTrigger>
                      </Border.Triggers>
                      <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTvCardTapped" CommandParameter="{Binding .}" />
                      </Border.GestureRecognizers>
                      <Grid RowDefinitions="145,*" InputTransparent="True">
                        <!-- Thumbnail 16:9 Limpa e Nítida -->
                        <Border Grid.Row="0" 
                                StrokeThickness="0" 
                                StrokeShape="RoundRectangle 20" 
                                InputTransparent="True">
                          <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True" />
                        </Border>

                        <!-- Título e Badge -->
                        <VerticalStackLayout Grid.Row="1" Padding="14,10" Spacing="4" InputTransparent="True">
                          <Label Text="{Binding Title}" 
                                 FontAttributes="Bold" 
                                 FontSize="14" 
                                 TextColor="#F8FAFC" 
                                 MaxLines="1" 
                                 LineBreakMode="TailTruncation" 
                                 InputTransparent="True" />
                          <Label Text="{Binding BadgeText}" 
                                 FontSize="12" 
                                 TextColor="#34D399" 
                                 FontAttributes="Bold" 
                                 InputTransparent="True" />
                        </VerticalStackLayout>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </CollectionView.ItemTemplate>
              </CollectionView>
            </VerticalStackLayout>

            <!-- 3. RAIL: OS MEUS FAVORITOS -->
            <VerticalStackLayout x:Name="TvFavoritesRail" Spacing="12">
              <Label Text="{loc:Translate TvFavorites}" FontSize="20" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center" />

              <CollectionView x:Name="TvFavoritesList" 
                              ItemsLayout="HorizontalList" 
                              HeightRequest="255" 
                              SelectionMode="None">
                <CollectionView.ItemTemplate>
                  <DataTemplate>
                    <Border StrokeShape="RoundRectangle 20" 
                            WidthRequest="300" 
                            HeightRequest="225"
                            Margin="4,8,22,14" 
                            Padding="0">
                      <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsTvFocused}" Value="True">
                          <Setter Property="Stroke" Value="{StaticResource TvFocusBorderBrush}" />
                          <Setter Property="StrokeThickness" Value="4" />
                          <Setter Property="Scale" Value="1.08" />
                          <Setter Property="BackgroundColor" Value="{StaticResource TvFocusCardBg}" />
                          <Setter Property="ZIndex" Value="10" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsTvFocused}" Value="False">
                          <Setter Property="Stroke" Value="{StaticResource TvNormalBorderBrush}" />
                          <Setter Property="StrokeThickness" Value="2" />
                          <Setter Property="Scale" Value="1.0" />
                          <Setter Property="BackgroundColor" Value="{StaticResource TvNormalCardBg}" />
                          <Setter Property="ZIndex" Value="1" />
                        </DataTrigger>
                      </Border.Triggers>
                      <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTvCardTapped" CommandParameter="{Binding .}" />
                      </Border.GestureRecognizers>
                      <Grid RowDefinitions="145,*" InputTransparent="True">
                        <Border Grid.Row="0" 
                                StrokeThickness="0" 
                                StrokeShape="RoundRectangle 20" 
                                InputTransparent="True">
                          <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True" />
                        </Border>

                        <VerticalStackLayout Grid.Row="1" Padding="14,10" Spacing="4" InputTransparent="True">
                          <Label Text="{Binding Title}" 
                                 FontAttributes="Bold" 
                                 FontSize="14" 
                                 TextColor="#F8FAFC" 
                                 MaxLines="1" 
                                 LineBreakMode="TailTruncation" 
                                 InputTransparent="True" />
                          <Label Text="{Binding BadgeText}" 
                                 FontSize="12" 
                                 TextColor="#F59E0B" 
                                 FontAttributes="Bold" 
                                 InputTransparent="True" />
                        </VerticalStackLayout>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </CollectionView.ItemTemplate>
              </CollectionView>
            </VerticalStackLayout>

            <!-- 4. RAIL: CATEGORIAS & TEMAS -->
            <VerticalStackLayout x:Name="TvCategoriesRail" Spacing="12">
              <Label Text="{loc:Translate TvCategories}" FontSize="20" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center" />

              <CollectionView x:Name="TvCategoriesList" 
                              ItemsLayout="HorizontalList" 
                              HeightRequest="120" 
                              SelectionMode="None">
                <CollectionView.ItemTemplate>
                  <DataTemplate>
                    <Border StrokeShape="RoundRectangle 18" 
                            WidthRequest="190" 
                            HeightRequest="90"
                            Margin="4,8,16,14" 
                            Padding="14,10">
                      <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsTvFocused}" Value="True">
                          <Setter Property="Stroke" Value="{StaticResource TvFocusBorderBrush}" />
                          <Setter Property="StrokeThickness" Value="4" />
                          <Setter Property="Scale" Value="1.08" />
                          <Setter Property="BackgroundColor" Value="{StaticResource TvFocusCardBg}" />
                          <Setter Property="ZIndex" Value="10" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsTvFocused}" Value="False">
                          <Setter Property="Stroke" Value="{StaticResource TvNormalBorderBrush}" />
                          <Setter Property="StrokeThickness" Value="2" />
                          <Setter Property="Scale" Value="1.0" />
                          <Setter Property="BackgroundColor" Value="{StaticResource TvNormalCardBg}" />
                          <Setter Property="ZIndex" Value="1" />
                        </DataTrigger>
                      </Border.Triggers>
                      <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTvCategoryCardTapped" CommandParameter="{Binding .}" />
                      </Border.GestureRecognizers>
                      <HorizontalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Center" InputTransparent="True">
                        <Label Text="{Binding Icon}" FontSize="32" VerticalOptions="Center" InputTransparent="True" />
                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" InputTransparent="True" />
                      </HorizontalStackLayout>
                    </Border>
                  </DataTemplate>
                </CollectionView.ItemTemplate>
              </CollectionView>
            </VerticalStackLayout>

            <!-- 5. ESTADO VAZIO NA TV (ACOLHEDOR & FOCÁVEL) -->
            <Border x:Name="TvEmptyStateView" 
                    IsVisible="False" 
                    Stroke="#334155" 
                    StrokeThickness="2" 
                    StrokeShape="RoundRectangle 24" 
                    BackgroundColor="#1E293B" 
                    Padding="32" 
                    Margin="0,20,0,0">
              <VerticalStackLayout Spacing="18" HorizontalOptions="Center">
                <Border BackgroundColor="#10B981" 
                        StrokeThickness="0" 
                        StrokeShape="RoundRectangle 36" 
                        HeightRequest="72" 
                        WidthRequest="72" 
                        HorizontalOptions="Center">
                  <Label Text="🎬" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="{loc:Translate EmptyStoriesTitle}" FontSize="22" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
                <Label Text="{loc:Translate EmptyStoriesDescription}" FontSize="15" TextColor="#94A3B8" HorizontalTextAlignment="Center" MaximumWidthRequest="500" />
                <Border x:Name="TvEmptyAdultsBtn" 
                        BackgroundColor="#10B981" 
                        Stroke="#34D399" 
                        StrokeThickness="3" 
                        StrokeShape="RoundRectangle 24" 
                        HeightRequest="52" 
                        Padding="28,0" 
                        HorizontalOptions="Center">
                  <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnParentsClicked" />
                  </Border.GestureRecognizers>
                  <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label Text="⚙️" FontSize="20" VerticalOptions="Center" />
                    <Label Text="{loc:Translate BtnOpenAdultArea}" FontSize="16" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" />
                  </HorizontalStackLayout>
                </Border>
              </VerticalStackLayout>
            </Border>

          </VerticalStackLayout>
        </ScrollView>
      </Grid>

      <!-- Ecrã de Fim de Tempo da Sessão -->
      <Border x:Name="TimeExpiredView" 
              IsVisible="False" 
              Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
              BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
              StrokeShape="RoundRectangle 24"
              Padding="24,20" 
              VerticalOptions="Center" 
              HorizontalOptions="Center" 
              Margin="16"
              MaximumWidthRequest="460">
        <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
          <Border BackgroundColor="{AppThemeBinding Light={StaticResource AccentAmberSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                  StrokeThickness="0" 
                  StrokeShape="RoundRectangle 36" 
                  HeightRequest="68" 
                  WidthRequest="68" 
                  HorizontalOptions="Center">
            <Label Text="🥣" FontSize="34" HorizontalOptions="Center" VerticalOptions="Center" />
          </Border>
          
          <Label Text="{loc:Translate TimeExpiredTitle}" 
                 FontSize="20" 
                 FontAttributes="Bold" 
                 TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                 HorizontalTextAlignment="Center" />
          
          <Label Text="{loc:Translate TimeExpiredSubtitle}" 
                 FontSize="13" 
                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                 HorizontalTextAlignment="Center" 
                 MaximumWidthRequest="320" />

          <!-- Atalhos Rápidos para os Adultos Darem Mais Minutos -->
          <VerticalStackLayout Spacing="6" HorizontalOptions="Fill" Margin="0,4,0,0">
            <Label Text="{loc:Translate BtnAddMinutes}" 
                   FontSize="12" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                   HorizontalTextAlignment="Center" />
            
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" HorizontalOptions="Fill">
              <!-- +5 Minutos -->
              <Button x:Name="BtnExpiredAdd5Min"
                      Text="{loc:Translate BtnAdd5Min}" 
                      Clicked="OnQuickAddMinutesClicked" 
                      CommandParameter="5" 
                      BackgroundColor="{StaticResource BrandGreen}" 
                      TextColor="{StaticResource White}" 
                      FontAttributes="Bold" 
                      CornerRadius="16" 
                      HeightRequest="44" 
                      FontSize="13" 
                      Padding="0" />
              
              <!-- +15 Minutos (Recomendado) -->
              <Button x:Name="BtnExpiredAdd15Min"
                      Grid.Column="1" 
                      Text="{loc:Translate BtnAdd15Min}" 
                      Clicked="OnQuickAddMinutesClicked" 
                      CommandParameter="15" 
                      BackgroundColor="{StaticResource BrandGreen}" 
                      TextColor="{StaticResource White}" 
                      FontAttributes="Bold" 
                      CornerRadius="16" 
                      HeightRequest="44" 
                      FontSize="13" 
                      Padding="0" />
              
              <!-- +30 Minutos -->
              <Button x:Name="BtnExpiredAdd30Min"
                      Grid.Column="2" 
                      Text="{loc:Translate BtnAdd30Min}" 
                      Clicked="OnQuickAddMinutesClicked" 
                      CommandParameter="30" 
                      BackgroundColor="{StaticResource BrandGreen}" 
                      TextColor="{StaticResource White}" 
                      FontAttributes="Bold" 
                      CornerRadius="16" 
                      HeightRequest="44" 
                      FontSize="13" 
                      Padding="0" />
            </Grid>
          </VerticalStackLayout>

          <!-- Separador Subtil -->
          <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="0,2" />

          <!-- Ações: Abrir Área de Adultos e Sair da App -->
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10" HorizontalOptions="Fill">
            <!-- Botão Área de Adultos -->
            <Button x:Name="BtnExpiredOpenParents"
                    Text="{loc:Translate BtnParentAreaNewTime}" 
                    Clicked="OnParentsClicked" 
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                    BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                    BorderWidth="1.5"
                    FontAttributes="Bold" 
                    CornerRadius="16" 
                    HeightRequest="46" 
                    FontSize="12" 
                    Padding="10,0" />

            <!-- Botão Sair da Aplicação -->
            <Button x:Name="BtnExpiredQuitApp"
                    Grid.Column="1" 
                    Text="{loc:Translate BtnQuitAppShort}" 
                    Clicked="OnQuitAppClicked" 
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentRedSoft}, Dark=#3B1414}" 
                    TextColor="{StaticResource AccentRed}" 
                    BorderColor="{StaticResource AccentRed}" 
                    BorderWidth="1.5" 
                    FontAttributes="Bold" 
                    CornerRadius="16" 
                    HeightRequest="46" 
                    FontSize="12" 
                    Padding="10,0" />
          </Grid>

        </VerticalStackLayout>
      </Border>
    </Grid>

    <!-- ========================================== -->
    <!-- 3. VISTA DE REPRODUÇÃO (PLAYER FULLSCREEN COM CONTROLOS FLUTUANTES) -->
    <!-- ========================================== -->
    <Grid x:Name="PlayerView" Grid.RowSpan="3" Margin="0" Padding="0" IsVisible="False" BackgroundColor="#000000" ZIndex="999">
      <Grid.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnPlayerScreenTapped" />
        <SwipeGestureRecognizer Direction="Up" Swiped="OnPlayerSwiped" />
        <SwipeGestureRecognizer Direction="Down" Swiped="OnPlayerSwiped" />
      </Grid.GestureRecognizers>

      <!-- 1. VÍDEO PRINCIPAL (OCUPA 100% DO ECRÃ TOTAL SEM CORTES OU SEAMS) -->
      <WebView x:Name="YoutubePlayer" 
               Navigating="OnPlayerNavigating" 
               HorizontalOptions="Fill" 
               VerticalOptions="Fill" 
               ZIndex="1" />

      <!-- 2. BARRA SUPERIOR DO PLAYER (OVERLAY FLUTUANTE) -->
      <Border x:Name="PlayerTopBar" 
              VerticalOptions="Start"
              BackgroundColor="#D90B132B" 
              StrokeThickness="0" 
              Padding="16,10" 
              ZIndex="30">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
          <!-- Botão Voltar -->
          <Button x:Name="PlayerBackBtn"
                  Text="{loc:Translate BtnBack}" 
                  Clicked="OnBackClicked" 
                  BackgroundColor="#1E293B" 
                  TextColor="#FFFFFF" 
                  BorderColor="#334155"
                  BorderWidth="1.5"
                  FontAttributes="Bold" 
                  CornerRadius="18" 
                  Padding="14,0" 
                  HeightRequest="38" 
                  FontSize="13" 
                  VerticalOptions="Center" />

          <!-- Informação do Vídeo no Topo -->
          <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
            <Label Text="🐥" FontSize="18" VerticalOptions="Center" />
            <Label x:Name="PlayerVideoTitleLabel" 
                   Text="yChicaTube" 
                   FontSize="14" 
                   FontAttributes="Bold" 
                   TextColor="#FFFFFF" 
                   LineBreakMode="TailTruncation" 
                   VerticalOptions="Center" />
          </HorizontalStackLayout>

          <!-- Badge Seguro -->
          <Border Grid.Column="2" 
                  BackgroundColor="#10B981" 
                  StrokeThickness="0" 
                  StrokeShape="RoundRectangle 12" 
                  Padding="10,4" 
                  VerticalOptions="Center">
            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
              <Label Text="✓" TextColor="#FFFFFF" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
              <Label Text="100% SEGURO" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
            </HorizontalStackLayout>
          </Border>
        </Grid>
      </Border>

      <!-- 3. GAVETA DE SUGESTÕES (SHELF FLUTUANTE ACIMA DOS CONTROLOS) -->
      <Border x:Name="PlayerSuggestionsDrawer"
              IsVisible="False"
              VerticalOptions="End"
              HorizontalOptions="Fill"
              BackgroundColor="#EE1E293B"
              Stroke="#334155"
              StrokeThickness="1.5"
              StrokeShape="RoundRectangle 16"
              Padding="12,10"
              Margin="16,0,16,80"
              ZIndex="35">
        <VerticalStackLayout Spacing="8">
          <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
              <Label Text="🎬" FontSize="16" VerticalOptions="Center" />
              <Label Text="{loc:Translate PlayerSuggestionsTitle}" FontSize="13" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Button Grid.Column="1" Text="✕" Clicked="OnClosePlayerSuggestionsClicked" BackgroundColor="#334155" TextColor="#F8FAFC" FontSize="12" FontAttributes="Bold" HeightRequest="28" WidthRequest="28" CornerRadius="14" Padding="0" />
          </Grid>
          <CollectionView x:Name="PlayerSuggestionsList" 
                          ItemsLayout="HorizontalList" 
                          SelectionMode="None"
                          HeightRequest="110">
            <CollectionView.ItemTemplate>
              <DataTemplate>
                <Border StrokeShape="RoundRectangle 14" BackgroundColor="#0F172A" Stroke="#334155" StrokeThickness="1.5" WidthRequest="160" HeightRequest="105" Margin="0,0,10,0" Padding="0">
                  <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsTvFocused}" Value="True">
                      <Setter Property="Stroke" Value="#FACC15" />
                      <Setter Property="StrokeThickness" Value="3.5" />
                      <Setter Property="Scale" Value="1.06" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding IsTvFocused}" Value="False">
                      <Setter Property="Stroke" Value="#334155" />
                      <Setter Property="StrokeThickness" Value="1.5" />
                      <Setter Property="Scale" Value="1.0" />
                    </DataTrigger>
                  </Border.Triggers>
                  <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPlayerSuggestionVideoTapped" CommandParameter="{Binding .}" />
                  </Border.GestureRecognizers>
                  <Grid RowDefinitions="68,*" InputTransparent="True">
                    <Border Grid.Row="0" StrokeThickness="0" StrokeShape="RoundRectangle 14" InputTransparent="True">
                      <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True" />
                    </Border>
                    <Label Grid.Row="1" Text="{Binding Title}" FontSize="10" TextColor="#F1F5F9" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" Padding="6,2" VerticalTextAlignment="Center" InputTransparent="True" />
                  </Grid>
                </Border>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>
        </VerticalStackLayout>
      </Border>

      <!-- 4. BARRA INFERIOR DE CONTROLOS (OVERLAY FLUTUANTE) -->
      <VerticalStackLayout x:Name="ControlsBar" 
                           VerticalOptions="End" 
                           BackgroundColor="#EE0B132B" 
                           Spacing="6" 
                           Padding="16,8,16,12" 
                           ZIndex="30">
        
        <!-- Linha de Progresso Estilizada (Green Scrubber Bar) -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center" Margin="4,0">
          <Label x:Name="PlayerTimeElapsedLabel" Text="00:00" FontSize="11" FontAttributes="Bold" TextColor="#94A3B8" VerticalOptions="Center" />
          
          <Border Grid.Column="1" BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 4" HeightRequest="6" VerticalOptions="Center">
            <BoxView HorizontalOptions="Fill" HeightRequest="6" CornerRadius="3" Color="#10B981" />
          </Border>

          <Label x:Name="TimerLabel" Grid.Column="2" Text="⏱️ 15:00" FontSize="11" FontAttributes="Bold" TextColor="#34D399" VerticalOptions="Center" />
        </Grid>

        <!-- Fila de Botões de Controlo -->
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
          <!-- Botão Mais Histórias / Sugestões -->
          <Button x:Name="PlayerSuggestionsBtn"
                  Text="{loc:Translate BtnTogglePlayerSuggestions}"
                  Clicked="OnTogglePlayerSuggestionsClicked"
                  BackgroundColor="#1E293B"
                  TextColor="#34D399"
                  BorderColor="#334155"
                  BorderWidth="1"
                  FontAttributes="Bold"
                  CornerRadius="16"
                  Padding="14,0"
                  FontSize="12"
                  HeightRequest="40" 
                  VerticalOptions="Center" />

          <!-- Controlos Centrais: Play / Pause Grande e Marcante -->
          <HorizontalStackLayout Grid.Column="1" Spacing="14" HorizontalOptions="Center" VerticalOptions="Center">
            <Button x:Name="PlayPauseBtn"
                    Text="⏸"
                    Clicked="OnPlayPauseClicked"
                    BackgroundColor="#10B981"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    CornerRadius="24"
                    Padding="0"
                    WidthRequest="48"
                    HeightRequest="48"
                    FontSize="20" 
                    VerticalOptions="Center" />
          </HorizontalStackLayout>

          <!-- Botão Fechar Barra / Ocultar Controlos -->
          <Button Grid.Column="2" 
                  Text="✕" 
                  Clicked="OnHideControlsClicked" 
                  BackgroundColor="#1E293B" 
                  TextColor="#94A3B8" 
                  BorderColor="#334155" 
                  BorderWidth="1" 
                  CornerRadius="16" 
                  FontSize="14" 
                  WidthRequest="38" 
                  HeightRequest="38" 
                  Padding="0" 
                  VerticalOptions="Center" />
        </Grid>
      </VerticalStackLayout>
    </Grid>


    <!-- ========================================== -->
    <!-- 5. PAINEL DE CONTROLO DE ADULTOS (TABS MODERNAS E LIMPAS) -->
    <!-- ========================================== -->
    <Grid x:Name="ParentOverlay" 
          Grid.RowSpan="3" 
          Margin="0" 
          IsVisible="False" 
          BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}" 
          RowDefinitions="Auto,Auto,*">
      
      <!-- 1. Barra Superior da Área de Adultos -->
      <Grid HeightRequest="64" 
            Padding="24,8" 
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
            ColumnDefinitions="Auto,*,Auto" 
            VerticalOptions="Center">
        <Button x:Name="ParentBackBtn"
                Text="←" 
                Clicked="OnCloseParentsClicked" 
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                CornerRadius="22" 
                WidthRequest="48" 
                HeightRequest="48" 
                Padding="0" 
                FontSize="20" 
                FontAttributes="Bold" 
                VerticalOptions="Center" />
        
        <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="16,0,0,0" VerticalOptions="Center">
          <Label Text="{loc:Translate ParentAreaTitle}" 
                 FontSize="20" 
                 FontAttributes="Bold" 
                 TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
          <Label Text="{loc:Translate ParentAreaSubtitle}" 
                 FontSize="13" 
                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                 LineBreakMode="TailTruncation" />
        </VerticalStackLayout>
        
        <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
          <Button x:Name="ParentAddMinutesTopBtn"
                  Text="⏱️ +15m" 
                  Clicked="OnQuickAddMinutesClicked" 
                  CommandParameter="15"
                  BackgroundColor="{StaticResource BrandGreen}" 
                  TextColor="{StaticResource White}" 
                  CornerRadius="20" 
                  Padding="14,8" 
                  FontSize="13" 
                  FontAttributes="Bold" 
                  HeightRequest="44" 
                  VerticalOptions="Center" />

          <Button x:Name="ParentQuitTopBtn"
                  Text="{loc:Translate BtnQuitAppShort}" 
                  Clicked="OnQuitAppClicked" 
                  BackgroundColor="#DC2626" 
                  TextColor="{StaticResource White}" 
                  CornerRadius="20" 
                  Padding="14,8" 
                  FontSize="13" 
                  FontAttributes="Bold" 
                  HeightRequest="44" 
                  VerticalOptions="Center" />

          <Button x:Name="ParentCloseBtn"
                  Text="{loc:Translate BtnClose}" 
                  Clicked="OnCloseParentsClicked" 
                  BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                  TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                  CornerRadius="20" 
                  Padding="16,8" 
                  FontSize="14" 
                  FontAttributes="Bold" 
                  HeightRequest="44" 
                  VerticalOptions="Center" />
        </HorizontalStackLayout>
      </Grid>

      <!-- 2. Barra de Separadores (Tabs) Estilizados -->
      <Grid Grid.Row="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" Padding="16,6,16,10">
        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HorizontalOptions="Center">
          <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <!-- Tab 1: Histórias & Temas -->
            <Border x:Name="TabBtnStories" 
                    StrokeShape="RoundRectangle 18" 
                    Padding="16,9" 
                    BackgroundColor="{StaticResource BrandGreen}" 
                    Stroke="{StaticResource BrandGreen}" 
                    StrokeThickness="1.5">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAdultTabSelected" CommandParameter="stories" />
              </Border.GestureRecognizers>
              <Label x:Name="TabLblStories" Text="{loc:Translate AdultTabStories}" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource White}" VerticalOptions="Center" />
            </Border>

            <!-- Tab 2: Tempo & Limites -->
            <Border x:Name="TabBtnTime" 
                    StrokeShape="RoundRectangle 18" 
                    Padding="16,9" 
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                    StrokeThickness="1.5">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAdultTabSelected" CommandParameter="time" />
              </Border.GestureRecognizers>
              <Label x:Name="TabLblTime" Text="{loc:Translate AdultTabTime}" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" VerticalOptions="Center" />
            </Border>

            <!-- Tab 3: TVs & Sala -->
            <Border x:Name="TabBtnTvs" 
                    StrokeShape="RoundRectangle 18" 
                    Padding="16,9" 
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                    StrokeThickness="1.5">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAdultTabSelected" CommandParameter="tvs" />
              </Border.GestureRecognizers>
              <Label x:Name="TabLblTvs" Text="{loc:Translate AdultTabTvs}" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" VerticalOptions="Center" />
            </Border>

            <!-- Tab 4: Definições & PIN -->
            <Border x:Name="TabBtnSettings" 
                    StrokeShape="RoundRectangle 18" 
                    Padding="16,9" 
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                    StrokeThickness="1.5">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAdultTabSelected" CommandParameter="settings" />
              </Border.GestureRecognizers>
              <Label x:Name="TabLblSettings" Text="{loc:Translate AdultTabSettings}" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" VerticalOptions="Center" />
            </Border>
          </HorizontalStackLayout>
        </ScrollView>
      </Grid>

      <!-- 3. Conteúdo dos Separadores -->
      <ScrollView x:Name="ParentScrollView" Grid.Row="2" BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">
        <Grid Padding="16,10,16,28" HorizontalOptions="Center" MaximumWidthRequest="1200">
          
          <!-- ========================================== -->
          <!-- SEPARADOR 1: HISTÓRIAS & TEMAS -->
          <!-- ========================================== -->
          <Grid x:Name="AdultTabStoriesView" 
                IsVisible="True" 
                ColumnDefinitions="420,*" 
                ColumnSpacing="20" 
                RowSpacing="16" 
                HorizontalOptions="Center" 
                MaximumWidthRequest="1200">
            
            <!-- COLUNA ESQUERDA: CURADORIA, TEMAS & PESQUISA -->
            <VerticalStackLayout x:Name="ParentLeftColumn" Grid.Column="0" Spacing="16">
              
              <!-- MODO DE CURADORIA -->
              <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                      Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                      StrokeThickness="2" 
                      StrokeShape="RoundRectangle 18" 
                      Padding="16">
                <VerticalStackLayout Spacing="12">
                  <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="🧭" FontSize="18" VerticalOptions="Center" />
                    <Label Text="{loc:Translate CuratingModeTitle}" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                           FontSize="16" 
                           VerticalOptions="Center" />
                  </HorizontalStackLayout>

                  <Label Text="{loc:Translate CuratingModeDesc}" 
                         FontSize="12" 
                         TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                  <!-- Seletores dos 2 Modos -->
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <!-- Opção 1: Vídeos Aprovados -->
                    <Border x:Name="ModeApprovedCard"
                            Grid.Column="0"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="2"
                            Padding="12,10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}"
                            Stroke="{StaticResource BrandGreen}">
                      <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSelectModeApprovedTapped" />
                      </Border.GestureRecognizers>
                      <VerticalStackLayout Spacing="4">
                        <Label x:Name="ModeApprovedTitle" Text="{loc:Translate ModeApprovedVideos}" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="{loc:Translate ModeApprovedVideosDesc}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                      </VerticalStackLayout>
                    </Border>

                    <!-- Opção 2: Temas Permitidos -->
                    <Border x:Name="ModeThemesCard"
                            Grid.Column="1"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="2"
                            Padding="12,10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                      <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSelectModeThemesTapped" />
                      </Border.GestureRecognizers>
                      <VerticalStackLayout Spacing="4">
                        <Label x:Name="ModeThemesTitle" Text="{loc:Translate ModeThemes}" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="{loc:Translate ModeThemesDesc}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                      </VerticalStackLayout>
                    </Border>
                  </Grid>

                  <!-- Gestor de Temas -->
                  <VerticalStackLayout x:Name="ThemesManagerContainer" Spacing="10" Margin="0,4,0,0">
                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="0,2" />
                    
                    <Label Text="{loc:Translate ThemesManagementTitle}" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="{loc:Translate ThemesManagementDesc}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                    <!-- Caixa de Input de Nova Playlist em Extenso -->
                    <Border x:Name="NewThemeEntryBorder"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 16"
                            Padding="14,0"
                            HeightRequest="50"
                            HorizontalOptions="Fill">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                        <Label Text="🏷️" FontSize="16" VerticalOptions="Center" />
                        
                        <Entry x:Name="NewThemeEntry"
                               Grid.Column="1"
                               Placeholder="{loc:Translate ThemeInputPlaceholder}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               BackgroundColor="Transparent"
                               Completed="OnAddNewThemeClicked"
                               TextChanged="OnNewThemeTextChanged"
                               ReturnType="Done"
                               VerticalOptions="Center"
                               HorizontalOptions="Fill" />

                        <!-- Botão Limpar Texto -->
                        <Border x:Name="ClearThemeTextBtn"
                                Grid.Column="2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                WidthRequest="28"
                                HeightRequest="28"
                                IsVisible="False"
                                VerticalOptions="Center">
                          <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClearNewThemeClicked" />
                          </Border.GestureRecognizers>
                          <Label Text="✕"
                                 TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                 FontSize="13"
                                 FontAttributes="Bold"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center" />
                        </Border>

                        <!-- Microfone de Voz para Playlist -->
                        <Border x:Name="VoiceThemeBtn"
                                Grid.Column="3"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}"
                                Stroke="{StaticResource BrandGreen}"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 16"
                                WidthRequest="34"
                                HeightRequest="34"
                                Padding="0"
                                VerticalOptions="Center">
                          <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVoiceThemeClicked" />
                          </Border.GestureRecognizers>
                          <Label Text="🎙️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                      </Grid>
                    </Border>

                    <!-- Botão Adicionar Playlist em Extenso Abaixo da Caixa de Texto -->
                    <Button x:Name="BtnAddTheme"
                            Text="{loc:Translate BtnAddTheme}"
                            Clicked="OnAddNewThemeClicked"
                            BackgroundColor="{StaticResource BrandGreen}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="16"
                            HeightRequest="46"
                            HorizontalOptions="Fill" />

                    <!-- Lista de Playlists Autorizadas em Cartões Claros e com Espaço -->
                    <VerticalStackLayout Spacing="6" Margin="0,4,0,0">
                      <Label Text="Playlists Autorizadas (Toque para ver vídeos):" 
                             FontSize="12" 
                             FontAttributes="Bold" 
                             TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                      
                      <CollectionView x:Name="ParentThemesList"
                                      HeightRequest="180"
                                      SelectionMode="None"
                                      ItemsLayout="VerticalList">
                        <CollectionView.ItemTemplate>
                          <DataTemplate>
                            <Border StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                    StrokeThickness="1.5"
                                    Padding="12,8"
                                    Margin="0,0,0,8">
                              <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsTvFocused}" Value="True">
                                  <Setter Property="Stroke" Value="#FACC15" />
                                  <Setter Property="StrokeThickness" Value="3" />
                                  <Setter Property="BackgroundColor" Value="#1E293B" />
                                  <Setter Property="Scale" Value="1.02" />
                                </DataTrigger>
                              </Border.Triggers>
                              <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnParentThemeItemTapped" CommandParameter="{Binding .}" />
                              </Border.GestureRecognizers>
                              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Text="📁" FontSize="15" VerticalOptions="Center" />
                                <Label Grid.Column="1" 
                                       Text="{Binding Name}" 
                                       FontSize="13.5" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                                       LineBreakMode="TailTruncation" 
                                       VerticalOptions="Center">
                                  <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsTvFocused}" Value="True">
                                      <Setter Property="TextColor" Value="#FFFFFF" />
                                    </DataTrigger>
                                  </Label.Triggers>
                                </Label>
                                <Label Grid.Column="2" 
                                       Text="▶ Ver" 
                                       FontSize="11" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource BrandGreen}" 
                                       VerticalOptions="Center" />
                                <Button Grid.Column="3" 
                                        Text="✕" 
                                        Clicked="OnDeleteThemeClicked" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="{AppThemeBinding Light=#1AEF4444, Dark=#33EF4444}" 
                                        TextColor="#EF4444" 
                                        BorderColor="#EF4444" 
                                        BorderWidth="1" 
                                        CornerRadius="12" 
                                        HeightRequest="30" 
                                        WidthRequest="30" 
                                        Padding="0" 
                                        FontSize="12" 
                                        FontAttributes="Bold" 
                                        VerticalOptions="Center" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </CollectionView.ItemTemplate>
                      </CollectionView>
                    </VerticalStackLayout>

                    <!-- Botão Restaurar Playlists Sugeridas -->
                    <Button x:Name="BtnRestoreDefaultThemes"
                            Text="{loc:Translate BtnRestoreDefaultThemes}"
                            Clicked="OnRestoreDefaultThemesClicked"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                            BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                            BorderWidth="1.5"
                            CornerRadius="14"
                            FontSize="13"
                            FontAttributes="Bold"
                            HeightRequest="44"
                            HorizontalOptions="Fill" />

                    <!-- AVISO EXPLÍCITO / DISCLAIMER AOS PAIS SOBRE LINGUAGEM E YOUTUBE -->
                    <Border BackgroundColor="#1AEAB308"
                            Stroke="#EAB308"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 14"
                            Padding="12,10"
                            Margin="0,4,0,0">
                      <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                          <Label Text="⚠️" FontSize="14" VerticalOptions="Center" />
                          <Label Text="{loc:Translate ThemeDisclaimerTitle}" FontAttributes="Bold" FontSize="12" TextColor="#EAB308" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="{loc:Translate ThemeDisclaimerMessage}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" LineHeight="1.2" />
                      </VerticalStackLayout>
                    </Border>
                  </VerticalStackLayout>
                </VerticalStackLayout>
              </Border>

              <!-- PESQUISA YOUTUBE -->
              <Border x:Name="ParentYoutubeSearchContainer"
                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                      Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                      StrokeThickness="2"
                      StrokeShape="RoundRectangle 18" 
                      Padding="16">
                <VerticalStackLayout Spacing="14">
                  
                  <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="📚" FontSize="18" VerticalOptions="Center" />
                    <Label Text="{loc:Translate SearchAndManageTitle}" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                           FontSize="16" 
                           VerticalOptions="Center" />
                  </HorizontalStackLayout>

                  <!-- Barra de Pesquisa em Extenso -->
                  <Border x:Name="SearchEntryBorder"
                          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                          Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                          StrokeThickness="1.5" 
                          StrokeShape="RoundRectangle 16" 
                          Padding="14,0" 
                          HeightRequest="50" 
                          HorizontalOptions="Fill">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                      <Label Text="🔍" 
                             FontSize="16" 
                             TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                             VerticalOptions="Center" />
                      
                      <Entry x:Name="SearchEntry" 
                             Grid.Column="1" 
                             Placeholder="{loc:Translate SearchPlaceholder}" 
                             TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                             PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                             BackgroundColor="Transparent" 
                             FontSize="14" 
                             ReturnType="Search" 
                             Completed="OnSearchVideosClicked" 
                             TextChanged="OnSearchTextChanged" 
                             VerticalOptions="Center" 
                             HorizontalOptions="Fill" />

                      <!-- Botão Limpar -->
                      <Border x:Name="ClearSearchBtn" 
                              Grid.Column="2" 
                              BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                              StrokeThickness="0" 
                              StrokeShape="RoundRectangle 14" 
                              WidthRequest="28" 
                              HeightRequest="28" 
                              IsVisible="False" 
                              VerticalOptions="Center">
                        <Border.GestureRecognizers>
                          <TapGestureRecognizer Tapped="OnClearSearchClicked" />
                        </Border.GestureRecognizers>
                        <Label Text="✕" 
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                               FontSize="13" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                      </Border>

                      <!-- Microfone de Voz -->
                      <Border x:Name="VoiceSearchBtn" 
                              Grid.Column="3" 
                              BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                              Stroke="{StaticResource BrandGreen}" 
                              StrokeThickness="1.5" 
                              StrokeShape="RoundRectangle 16" 
                              WidthRequest="34" 
                              HeightRequest="34" 
                              Padding="0" 
                              VerticalOptions="Center">
                        <Border.GestureRecognizers>
                          <TapGestureRecognizer Tapped="OnVoiceSearchClicked" />
                        </Border.GestureRecognizers>
                        <Label Text="🎙️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                      </Border>
                    </Grid>
                  </Border>

                  <!-- Botão Pesquisar por baixo da Caixa de Texto -->
                  <Button x:Name="BtnSearchYoutubeBig"
                          Text="{loc:Translate BtnSearchYoutube}" 
                          Clicked="OnSearchVideosClicked" 
                          BackgroundColor="{StaticResource BrandGreen}" 
                          TextColor="{StaticResource White}" 
                          CornerRadius="16" 
                          HeightRequest="46" 
                          FontSize="14" 
                          FontAttributes="Bold" 
                          HorizontalOptions="Fill" />

                  <!-- Sugestões Rápidas (Chips com Foco TV) -->
                  <VerticalStackLayout Spacing="6">
                    <Label Text="{loc:Translate QuickSuggestionsLabel}" 
                           FontSize="12" 
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                           FontAttributes="Bold" />
                    
                    <CollectionView x:Name="SuggestionsList" ItemsLayout="HorizontalList" HeightRequest="48" SelectionMode="None">
                      <CollectionView.ItemTemplate>
                        <DataTemplate>
                          <Border StrokeShape="RoundRectangle 16" 
                                  Padding="14,8" 
                                  Margin="0,2,10,2">
                            <Border.Triggers>
                              <DataTrigger TargetType="Border" Binding="{Binding IsTvFocused}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource TvFocusBorderBrush}" />
                                <Setter Property="StrokeThickness" Value="3" />
                                <Setter Property="Scale" Value="1.08" />
                                <Setter Property="BackgroundColor" Value="{StaticResource TvFocusCardBg}" />
                              </DataTrigger>
                              <DataTrigger TargetType="Border" Binding="{Binding IsTvFocused}" Value="False">
                                <Setter Property="Stroke" Value="Transparent" />
                                <Setter Property="StrokeThickness" Value="0" />
                                <Setter Property="Scale" Value="1.0" />
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" />
                              </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                              <TapGestureRecognizer Tapped="OnSuggestionTapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center" InputTransparent="True">
                              <Label Text="✨" FontSize="13" TextColor="{StaticResource BrandGreen}" VerticalOptions="Center" InputTransparent="True" />
                              <Label Text="{Binding Text}" 
                                     TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                                     FontSize="13" 
                                     FontAttributes="Bold" 
                                     VerticalOptions="Center" 
                                     InputTransparent="True">
                                <Label.Triggers>
                                  <DataTrigger TargetType="Label" Binding="{Binding IsTvFocused}" Value="True">
                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                  </DataTrigger>
                                </Label.Triggers>
                              </Label>
                            </HorizontalStackLayout>
                          </Border>
                        </DataTemplate>
                      </CollectionView.ItemTemplate>
                    </CollectionView>
                  </VerticalStackLayout>

                  <ActivityIndicator x:Name="SearchIndicator" IsRunning="False" IsVisible="False" Color="{StaticResource BrandGreen}" HeightRequest="26" />
                </VerticalStackLayout>
              </Border>

            </VerticalStackLayout>

            <!-- COLUNA DIREITA: GESTÃO & RESULTADOS DE HISTÓRIAS -->
            <Border x:Name="ParentRightColumn"
                    Grid.Column="1" 
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                    StrokeThickness="2" 
                    StrokeShape="RoundRectangle 20" 
                    Padding="20" 
                    VerticalOptions="Fill">
              <VerticalStackLayout Spacing="14">
                
                <!-- Cabeçalho da Lista de Histórias com Título por Cima dos Botões -->
                <VerticalStackLayout Spacing="8">
                  <Label x:Name="ListSectionTitle" 
                         Text="{loc:Translate AuthorizedStoriesCount}" 
                         FontAttributes="Bold" 
                         TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                         FontSize="16" 
                         LineBreakMode="WordWrap" />
                  
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                    <Button x:Name="BtnSendApprovedListToTv"
                            Grid.Column="0" 
                            Text="📺 Enviar para TV" 
                            Clicked="OnSendApprovedListToTvClicked" 
                            BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                            TextColor="{StaticResource BrandGreen}" 
                            BorderColor="{StaticResource BrandGreen}" 
                            BorderWidth="1.5" 
                            CornerRadius="14" 
                            HeightRequest="36" 
                            Padding="12,0" 
                            FontSize="12" 
                            FontAttributes="Bold" 
                            VerticalOptions="Center" />

                    <Label Grid.Column="1" 
                           Text="{loc:Translate ToggleHelpText}" 
                           FontSize="12" 
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                           VerticalOptions="Center" />
                  </Grid>
                </VerticalStackLayout>

                <!-- Lista de Histórias com Foco TV Elegante e Qualidade de Ecrã Principal -->
                <CollectionView x:Name="ParentUnifiedVideoList" SelectionMode="None" HeightRequest="560">
                  <CollectionView.ItemTemplate>
                    <DataTemplate>
                      <Border StrokeShape="RoundRectangle 18" 
                              Margin="0,0,0,16" 
                              Padding="0">
                        <Border.Triggers>
                          <DataTrigger TargetType="Border" Binding="{Binding IsTvFocused}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource TvFocusBorderBrush}" />
                            <Setter Property="StrokeThickness" Value="4" />
                            <Setter Property="Scale" Value="1.03" />
                            <Setter Property="BackgroundColor" Value="{StaticResource TvFocusCardBg}" />
                            <Setter Property="ZIndex" Value="10" />
                          </DataTrigger>
                          <DataTrigger TargetType="Border" Binding="{Binding IsTvFocused}" Value="False">
                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                            <Setter Property="StrokeThickness" Value="1.5" />
                            <Setter Property="Scale" Value="1.0" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" />
                          </DataTrigger>
                        </Border.Triggers>

                        <VerticalStackLayout Spacing="0">
                          <!-- 1. Miniatura 16:9 Limpa e Nítida com Tap para Preview e Badge de Aprovado Flutuante -->
                          <Grid HeightRequest="185" HorizontalOptions="Fill">
                            <Border StrokeThickness="0" 
                                    StrokeShape="RoundRectangle 18" 
                                    HorizontalOptions="Fill" 
                                    VerticalOptions="Fill">
                              <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnThumbnailPreviewTapped" CommandParameter="{Binding .}" />
                              </Border.GestureRecognizers>
                              <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" />
                            </Border>

                            <!-- Ícone Flutuante Central de Pré-visualização -->
                            <Border BackgroundColor="#99000000" 
                                    StrokeShape="RoundRectangle 24" 
                                    StrokeThickness="0" 
                                    WidthRequest="48" 
                                    HeightRequest="48" 
                                    HorizontalOptions="Center" 
                                    VerticalOptions="Center">
                              <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnThumbnailPreviewTapped" CommandParameter="{Binding .}" />
                              </Border.GestureRecognizers>
                              <Label Text="▶" TextColor="White" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" Margin="2,0,0,0" />
                            </Border>

                            <!-- Badge de Autorizado no Canto Superior (Apenas se Aprovado) -->
                            <Border BackgroundColor="{Binding StatusBadgeBgColor}" 
                                    StrokeThickness="1" 
                                    Stroke="{Binding StatusBadgeColor}" 
                                    StrokeShape="RoundRectangle 12" 
                                    Padding="10,4" 
                                    Margin="12,12,0,0" 
                                    HorizontalOptions="Start" 
                                    VerticalOptions="Start"
                                    IsVisible="{Binding IsApproved}">
                              <Label Text="{Binding StatusBadgeText}" 
                                     TextColor="{Binding StatusBadgeColor}" 
                                     FontAttributes="Bold" 
                                     FontSize="11" />
                            </Border>
                          </Grid>

                          <!-- 2. Área Inferior: Título e Barra de Ações Rápidas -->
                          <VerticalStackLayout Padding="14,12" Spacing="10">
                            <Label Text="{Binding Title}" 
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                                   FontAttributes="Bold" 
                                   FontSize="15" 
                                   LineBreakMode="TailTruncation" 
                                   MaxLines="2">
                              <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsTvFocused}" Value="True">
                                  <Setter Property="TextColor" Value="#FFFFFF" />
                                </DataTrigger>
                              </Label.Triggers>
                              <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnThumbnailPreviewTapped" CommandParameter="{Binding .}" />
                              </Label.GestureRecognizers>
                            </Label>

                            <!-- Barra de Botões com Ações Claras e Separadas -->
                            <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                              <!-- Botão Pré-visualizar Vídeo -->
                              <Button Grid.Column="0" 
                                      Text="{loc:Translate BtnPreviewVideo}" 
                                      Clicked="OnDirectPreviewClicked" 
                                      CommandParameter="{Binding .}" 
                                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                                      TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                                      BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                                      BorderWidth="1.5" 
                                      CornerRadius="14" 
                                      HeightRequest="42" 
                                      FontSize="13" 
                                      FontAttributes="Bold" 
                                      Padding="6,0" 
                                      VerticalOptions="Center" />

                              <!-- Botão Ocultar / Bloquear Vídeo -->
                              <Button Grid.Column="1" 
                                      Text="{loc:Translate BtnBlockVideo}" 
                                      Clicked="OnDirectBlockVideoClicked" 
                                      CommandParameter="{Binding .}" 
                                      BackgroundColor="{AppThemeBinding Light=#1AEF4444, Dark=#33EF4444}" 
                                      TextColor="#EF4444" 
                                      BorderColor="#EF4444" 
                                      BorderWidth="1.5" 
                                      CornerRadius="14" 
                                      HeightRequest="42" 
                                      FontSize="13" 
                                      FontAttributes="Bold" 
                                      Padding="6,0" 
                                      VerticalOptions="Center" />

                              <!-- Botão Enviar para TV individual -->
                              <Button Grid.Column="2" 
                                      Text="📺 TV" 
                                      Clicked="OnQuickSendSingleVideoToTvClicked" 
                                      CommandParameter="{Binding .}" 
                                      IsVisible="{Binding IsSendToTvVisible}"
                                      BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                                      TextColor="{StaticResource BrandGreen}" 
                                      BorderColor="{StaticResource BrandGreen}" 
                                      BorderWidth="1.5" 
                                      CornerRadius="14" 
                                      WidthRequest="72" 
                                      HeightRequest="42" 
                                      FontSize="13" 
                                      FontAttributes="Bold" 
                                      Padding="4,0" 
                                      VerticalOptions="Center" />

                              <!-- Botão de Ação Autorizar (+ / ✓) -->
                              <Button Grid.Column="3" 
                                      Text="{Binding ActionButtonText}" 
                                      Clicked="OnToggleApprovalClicked" 
                                      CommandParameter="{Binding .}" 
                                      BackgroundColor="{Binding ActionButtonColor}" 
                                      TextColor="{Binding ActionButtonTextColor}" 
                                      FontAttributes="Bold" 
                                      CornerRadius="21" 
                                      WidthRequest="46" 
                                      HeightRequest="42" 
                                      Padding="0" 
                                      FontSize="18" 
                                      VerticalOptions="Center" />
                            </Grid>
                          </VerticalStackLayout>
                        </VerticalStackLayout>
                      </Border>
                    </DataTemplate>
                  </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Botão Carregar Mais Histórias -->
                <VerticalStackLayout x:Name="LoadMoreSearchContainer" IsVisible="False" Spacing="8" Margin="0,6,0,4">
                  <Button x:Name="LoadMoreSearchBtn" 
                          Text="{loc:Translate BtnLoadMoreStories}" 
                          Clicked="OnLoadMoreSearchResultsClicked" 
                          BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                          TextColor="{AppThemeBinding Light={StaticResource BrandGreenDark}, Dark={StaticResource BrandGreenLight}}" 
                          BorderColor="{AppThemeBinding Light={StaticResource BrandGreen}, Dark={StaticResource BrandGreenLight}}" 
                          BorderWidth="2" 
                          FontAttributes="Bold" 
                          CornerRadius="20" 
                          Padding="16,10" 
                          FontSize="14" 
                          HeightRequest="48" 
                          HorizontalOptions="Fill" />
                  <ActivityIndicator x:Name="LoadMoreSearchIndicator" IsRunning="False" IsVisible="False" Color="{StaticResource BrandGreen}" HeightRequest="26" />
                </VerticalStackLayout>

                <!-- Mensagem quando a lista de gestão está vazia -->
                <Label x:Name="EmptyParentListLabel" 
                       Text="{loc:Translate EmptyParentListHint}" 
                       IsVisible="False" 
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                       FontSize="14" 
                       HorizontalTextAlignment="Center" 
                       Margin="0,16" />
              </VerticalStackLayout>
            </Border>

          </Grid>

          <!-- ========================================== -->
          <!-- SEPARADOR 2: TEMPO & LIMITES -->
          <!-- ========================================== -->
          <VerticalStackLayout x:Name="AdultTabTimeView" 
                               IsVisible="False" 
                               Spacing="16" 
                               MaximumWidthRequest="600" 
                               HorizontalOptions="Center">
            
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                    StrokeThickness="2" 
                    StrokeShape="RoundRectangle 20" 
                    Padding="22">
              <VerticalStackLayout Spacing="16">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                  <Label Text="⏱️" FontSize="22" VerticalOptions="Center" />
                  <VerticalStackLayout Spacing="2">
                    <Label Text="{loc:Translate MealDurationTitle}" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                           FontSize="17" />
                    <Label Text="{loc:Translate MealDurationHint}" 
                           FontSize="12" 
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                  </VerticalStackLayout>
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                  <Label x:Name="MinutesLabel" 
                         Text="15 minutos" 
                         TextColor="{StaticResource BrandGreen}" 
                         FontAttributes="Bold" 
                         FontSize="26" 
                         VerticalOptions="Center" />
                  
                  <!-- Controlo de Tempo - / + com Foco TV Separado -->
                  <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                    <Border x:Name="TvDurationMinusBtn" 
                            StrokeShape="RoundRectangle 16" 
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                            StrokeThickness="1.5" 
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                            WidthRequest="54" 
                            HeightRequest="50" 
                            Padding="0">
                      <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDecreaseMinutesClicked" />
                      </Border.GestureRecognizers>
                      <Label Text="−" 
                             FontSize="26" 
                             FontAttributes="Bold" 
                             TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                             HorizontalOptions="Center" 
                             VerticalOptions="Center" />
                    </Border>

                    <Border x:Name="TvDurationPlusBtn" 
                            StrokeShape="RoundRectangle 16" 
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                            StrokeThickness="1.5" 
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                            WidthRequest="54" 
                            HeightRequest="50" 
                            Padding="0">
                      <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnIncreaseMinutesClicked" />
                      </Border.GestureRecognizers>
                      <Label Text="+" 
                             FontSize="26" 
                             FontAttributes="Bold" 
                             TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                             HorizontalOptions="Center" 
                             VerticalOptions="Center" />
                    </Border>
                  </HorizontalStackLayout>
                </Grid>

                <Button x:Name="ResetSessionBtn" 
                        Text="{loc:Translate BtnStartResetTimer}" 
                        Clicked="OnResetSessionClicked" 
                        BackgroundColor="{StaticResource BrandGreen}" 
                        TextColor="{StaticResource White}" 
                        FontAttributes="Bold" 
                        CornerRadius="18" 
                        Padding="16,10" 
                        FontSize="15" 
                        HeightRequest="50" 
                        HorizontalOptions="Fill" />
              </VerticalStackLayout>
            </Border>

          </VerticalStackLayout>


          <!-- ========================================== -->
          <!-- SEPARADOR 4: DEFINIÇÕES & PIN -->
          <!-- ========================================== -->
          <VerticalStackLayout x:Name="AdultTabSettingsView" 
                               IsVisible="False" 
                               Spacing="16" 
                               MaximumWidthRequest="600" 
                               HorizontalOptions="Center">
            
            <!-- IDIOMA DA APLICAÇÃO E CONTEÚDOS (TOP 3 PREFERÊNCIAS) -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                    StrokeThickness="2" 
                    StrokeShape="RoundRectangle 20" 
                    Padding="20">
              <VerticalStackLayout Spacing="14">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                  <Label Text="🌍" FontSize="20" VerticalOptions="Center" />
                  <Label Text="{loc:Translate LanguageSettingsTitle}" 
                         FontAttributes="Bold" 
                         TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                         FontSize="16" 
                         VerticalOptions="Center" />
                </HorizontalStackLayout>
                
                <Label Text="{loc:Translate LanguageSettingsDesc}" 
                       FontSize="12" 
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                <!-- 1º IDIOMA (PRINCIPAL) -->
                <VerticalStackLayout Spacing="4">
                  <Label Text="{loc:Translate LanguagePrimaryLabel}" 
                         FontSize="12" 
                         FontAttributes="Bold" 
                         TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                  <Border x:Name="LanguagePickerBorder" 
                          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                          Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                          StrokeThickness="1.5" 
                          StrokeShape="RoundRectangle 14" 
                          Padding="14,0" 
                          HeightRequest="48" 
                          HorizontalOptions="Fill">
                    <Picker x:Name="LanguagePicker" 
                            SelectedIndexChanged="OnLanguagePickerChanged" 
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                            TitleColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                            FontSize="14" 
                            VerticalOptions="Center" 
                            HorizontalOptions="Fill" />
                  </Border>
                </VerticalStackLayout>

                <!-- 2º IDIOMA (SECUNDÁRIO) -->
                <VerticalStackLayout Spacing="4">
                  <Label Text="{loc:Translate LanguageSecondaryLabel}" 
                         FontSize="12" 
                         FontAttributes="Bold" 
                         TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                  <Border x:Name="LanguagePickerBorder2" 
                          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                          Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                          StrokeThickness="1.5" 
                          StrokeShape="RoundRectangle 14" 
                          Padding="14,0" 
                          HeightRequest="48" 
                          HorizontalOptions="Fill">
                    <Picker x:Name="LanguagePicker2" 
                            SelectedIndexChanged="OnLanguagePicker2Changed" 
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                            TitleColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                            FontSize="14" 
                            VerticalOptions="Center" 
                            HorizontalOptions="Fill" />
                  </Border>
                </VerticalStackLayout>

                <!-- 3º IDIOMA (TERCEIRO / OPCIONAL) -->
                <VerticalStackLayout Spacing="4">
                  <Label Text="{loc:Translate LanguageTertiaryLabel}" 
                         FontSize="12" 
                         FontAttributes="Bold" 
                         TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                  <Border x:Name="LanguagePickerBorder3" 
                          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                          Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                          StrokeThickness="1.5" 
                          StrokeShape="RoundRectangle 14" 
                          Padding="14,0" 
                          HeightRequest="48" 
                          HorizontalOptions="Fill">
                    <Picker x:Name="LanguagePicker3" 
                            SelectedIndexChanged="OnLanguagePicker3Changed" 
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                            TitleColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                            FontSize="14" 
                            VerticalOptions="Center" 
                            HorizontalOptions="Fill" />
                  </Border>
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>

            <!-- GESTÃO DE VÍDEOS OCULTADOS / BLOQUEADOS DOS TEMAS -->
            <Border x:Name="BlockedVideosCard"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                    StrokeThickness="2" 
                    StrokeShape="RoundRectangle 20" 
                    Padding="18">
              <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                  <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="🚫" FontSize="18" VerticalOptions="Center" />
                    <Label x:Name="BlockedVideosHeaderLabel" 
                           Text="Vídeos Ocultados dos Temas" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                           FontSize="15" 
                           VerticalOptions="Center" />
                  </HorizontalStackLayout>
                  
                  <Border BackgroundColor="{AppThemeBinding Light=#1AEF4444, Dark=#33EF4444}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="8,2">
                    <Label x:Name="BlockedCountBadge" 
                           Text="0" 
                           TextColor="#EF4444" 
                           FontAttributes="Bold" 
                           FontSize="12" 
                           VerticalOptions="Center" />
                  </Border>
                </Grid>
                
                <Label Text="{loc:Translate BlockedVideosDesc}" 
                       FontSize="12" 
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                <!-- Lista de Vídeos Bloqueados -->
                <CollectionView x:Name="BlockedVideosList" HeightRequest="150" SelectionMode="None">
                  <CollectionView.ItemTemplate>
                    <DataTemplate>
                      <Border StrokeShape="RoundRectangle 12" 
                              BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                              Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                              StrokeThickness="1.5" 
                              Padding="10,6" 
                              Margin="0,2,0,4">
                        <Border.Triggers>
                          <DataTrigger TargetType="Border" Binding="{Binding IsTvFocused}" Value="True">
                            <Setter Property="Stroke" Value="#FACC15" />
                            <Setter Property="StrokeThickness" Value="3.5" />
                            <Setter Property="Scale" Value="1.03" />
                          </DataTrigger>
                          <DataTrigger TargetType="Border" Binding="{Binding IsTvFocused}" Value="False">
                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                            <Setter Property="StrokeThickness" Value="1.5" />
                            <Setter Property="Scale" Value="1.0" />
                          </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                          <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="34" WidthRequest="54" VerticalOptions="Center">
                            <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill" />
                          </Border>
                          <Label Grid.Column="1" 
                                 Text="{Binding Title}" 
                                 FontSize="12" 
                                 FontAttributes="Bold" 
                                 TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                                 LineBreakMode="TailTruncation" 
                                 MaxLines="1" 
                                 VerticalOptions="Center">
                            <Label.Triggers>
                              <DataTrigger TargetType="Label" Binding="{Binding IsTvFocused}" Value="True">
                                <Setter Property="TextColor" Value="#FFFFFF" />
                              </DataTrigger>
                            </Label.Triggers>
                          </Label>
                          <Button Grid.Column="2" Text="{loc:Translate BtnUnblockVideo}" Clicked="OnUnblockVideoClicked" CommandParameter="{Binding .}" BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" TextColor="{StaticResource BrandGreen}" BorderColor="{StaticResource BrandGreen}" BorderWidth="1" CornerRadius="12" HeightRequest="32" Padding="10,0" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </CollectionView.ItemTemplate>
                </CollectionView>

                <Label x:Name="NoBlockedVideosLabel" 
                       Text="{loc:Translate NoBlockedVideos}" 
                       FontSize="12" 
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                       HorizontalTextAlignment="Center" 
                       Margin="0,4" />
              </VerticalStackLayout>
            </Border>

            <!-- ALTERAR PIN -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                    StrokeThickness="2" 
                    StrokeShape="RoundRectangle 20" 
                    Padding="20">
              <VerticalStackLayout Spacing="14">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                  <Label Text="🔒" FontSize="18" VerticalOptions="Center" />
                  <Label Text="{loc:Translate ChangePinTitle}" 
                         FontAttributes="Bold" 
                         TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                         FontSize="16" 
                         VerticalOptions="Center" />
                </HorizontalStackLayout>
                
                <Label Text="{loc:Translate ChangePinDescription}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <Border x:Name="NewPinBorder" 
                          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                          Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                          StrokeThickness="1.5" 
                          StrokeShape="RoundRectangle 14" 
                          Padding="14,0" 
                          HeightRequest="48" 
                          HorizontalOptions="Fill">
                    <Entry x:Name="NewPinEntry" 
                           Placeholder="{loc:Translate PinPlaceholder}" 
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                           BackgroundColor="Transparent" 
                           Keyboard="Numeric" 
                           MaxLength="4" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           HorizontalTextAlignment="Center" 
                           IsPassword="True" 
                           VerticalOptions="Center" 
                           HorizontalOptions="Fill" />
                  </Border>
                  
                  <Button x:Name="SavePinBtn" 
                          Grid.Column="1" 
                          Text="{loc:Translate BtnSavePin}" 
                          Clicked="OnSavePinClicked" 
                          BackgroundColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray700}}" 
                          TextColor="{StaticResource White}" 
                          FontAttributes="Bold" 
                          CornerRadius="14" 
                          Padding="16,8" 
                          FontSize="14" 
                          HeightRequest="48" />
                </Grid>
              </VerticalStackLayout>
            </Border>

            <!-- BIOMETRIA -->
            <Border x:Name="BiometricOptionView" 
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                    StrokeThickness="2" 
                    StrokeShape="RoundRectangle 20" 
                    Padding="16">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBiometricToggleTapped" />
              </Border.GestureRecognizers>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                  <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="👆" FontSize="16" VerticalOptions="Center" />
                    <Label Text="{loc:Translate BiometricSwitchTitle}" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                           FontSize="15" 
                           VerticalOptions="Center" />
                  </HorizontalStackLayout>
                  <Label Text="{loc:Translate BiometricSwitchDesc}" 
                         FontSize="12" 
                         TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
                
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                  <Label x:Name="BiometricStateLabel" 
                         Text="Ligado" 
                         FontSize="13" 
                         FontAttributes="Bold" 
                         TextColor="{StaticResource BrandGreen}" 
                         VerticalOptions="Center" />
                  
                  <Border x:Name="BiometricToggle" 
                          StrokeThickness="0" 
                          StrokeShape="RoundRectangle 16" 
                          BackgroundColor="{StaticResource BrandGreen}" 
                          WidthRequest="56" 
                          HeightRequest="32" 
                          Padding="2" 
                          VerticalOptions="Center">
                    <Border.GestureRecognizers>
                      <TapGestureRecognizer Tapped="OnBiometricToggleTapped" />
                    </Border.GestureRecognizers>
                    <Border x:Name="BiometricThumb" 
                            StrokeThickness="0" 
                            StrokeShape="RoundRectangle 14" 
                            BackgroundColor="{StaticResource White}" 
                            WidthRequest="28" 
                            HeightRequest="28" 
                            HorizontalOptions="End" 
                            VerticalOptions="Center" />
                  </Border>
                </HorizontalStackLayout>
              </Grid>
            </Border>

            <!-- DESCOBERTA INFANTIL -->
            <Border x:Name="AllowChildDiscoverBorder" 
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                    StrokeThickness="2" 
                    StrokeShape="RoundRectangle 20" 
                    Padding="16">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAllowChildDiscoverToggleTapped" />
              </Border.GestureRecognizers>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                  <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="🎲" FontSize="18" VerticalOptions="Center" />
                    <Label Text="{loc:Translate AllowChildDiscoverSwitchTitle}" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                           FontSize="15" 
                           VerticalOptions="Center" />
                  </HorizontalStackLayout>
                  <Label Text="{loc:Translate AllowChildDiscoverSwitchDesc}" 
                         FontSize="12" 
                         TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
                
                <!-- Toggle Switch -->
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                  <Label x:Name="AllowChildDiscoverStateLabel" 
                         Text="Desligado" 
                         FontSize="13" 
                         FontAttributes="Bold" 
                         TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                         VerticalOptions="Center" />
                  
                  <Border x:Name="AllowChildDiscoverToggle" 
                          StrokeThickness="0" 
                          StrokeShape="RoundRectangle 16" 
                          BackgroundColor="#D1D5DB" 
                          WidthRequest="56" 
                          HeightRequest="32" 
                          Padding="2" 
                          VerticalOptions="Center">
                    <Border.GestureRecognizers>
                      <TapGestureRecognizer Tapped="OnAllowChildDiscoverToggleTapped" />
                    </Border.GestureRecognizers>
                    <Border x:Name="AllowChildDiscoverThumb" 
                            StrokeThickness="0" 
                            StrokeShape="RoundRectangle 14" 
                            BackgroundColor="{StaticResource White}" 
                            WidthRequest="28" 
                            HeightRequest="28" 
                            HorizontalOptions="Start" 
                            VerticalOptions="Center" />
                  </Border>
                </HorizontalStackLayout>
              </Grid>
            </Border>

            <!-- MODO CRIANÇA / FIXAR ECRÃ & SAIR -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                    StrokeThickness="2" 
                    StrokeShape="RoundRectangle 20" 
                    Padding="16">
              <VerticalStackLayout Spacing="14">
                <VerticalStackLayout x:Name="ScreenLockContainer" Spacing="10">
                  <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="🛡️" FontSize="16" VerticalOptions="Center" />
                    <Label Text="{loc:Translate ChildModeTitle}" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                           FontSize="15" 
                           VerticalOptions="Center" />
                  </HorizontalStackLayout>
                  
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button x:Name="LockAppBtn" 
                            Text="{loc:Translate BtnLockScreen}" 
                            Clicked="OnLockAppClicked" 
                            BackgroundColor="{StaticResource BrandGreen}" 
                            TextColor="{StaticResource White}" 
                            FontAttributes="Bold" 
                            CornerRadius="14" 
                            Padding="12,6" 
                            FontSize="14" 
                            HeightRequest="46" />
                    
                    <Button x:Name="UnlockAppBtn" 
                            Grid.Column="1" 
                            Text="{loc:Translate BtnUnlockScreen}" 
                            Clicked="OnUnlockAppClicked" 
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                            FontAttributes="Bold" 
                            CornerRadius="14" 
                            Padding="12,6" 
                            FontSize="14" 
                            HeightRequest="46" />
                  </Grid>
                </VerticalStackLayout>

                <Button x:Name="QuitAppBtn" 
                        Text="{loc:Translate BtnQuitApp}" 
                        Clicked="OnQuitAppClicked" 
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentRedSoft}, Dark=#3B1414}" 
                        TextColor="{StaticResource AccentRed}" 
                        BorderColor="{StaticResource AccentRed}" 
                        BorderWidth="1.5" 
                        FontAttributes="Bold" 
                        CornerRadius="14" 
                        Padding="14,8" 
                        FontSize="14" 
                        HeightRequest="46" 
                        HorizontalOptions="Fill" />
              </VerticalStackLayout>
            </Border>

            <!-- APRESENTAÇÃO & TUTORIAL DA APP -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                    StrokeThickness="2" 
                    StrokeShape="RoundRectangle 20" 
                    Padding="16">
              <VerticalStackLayout Spacing="10">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                  <Label Text="🎓" FontSize="18" VerticalOptions="Center" />
                  <Label Text="{loc:Translate TutorialCardTitle}" 
                         FontAttributes="Bold" 
                         TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                         FontSize="15" 
                         VerticalOptions="Center" />
                </HorizontalStackLayout>
                
                <Label Text="{loc:Translate TutorialCardDesc}" 
                       FontSize="12" 
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                <Button x:Name="BtnSettingsViewTutorial" 
                        Text="{loc:Translate BtnViewTutorial}" 
                        Clicked="OnShowOnboardingClicked" 
                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                        TextColor="{StaticResource BrandGreen}" 
                        BorderColor="{StaticResource BrandGreen}" 
                        BorderWidth="1.5" 
                        FontAttributes="Bold" 
                        CornerRadius="14" 
                        Padding="12,6" 
                        FontSize="13" 
                        HeightRequest="46" />
              </VerticalStackLayout>
            </Border>

            <!-- TERMOS DE UTILIZAÇÃO & CONTACTO / FEEDBACK -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                    StrokeThickness="2" 
                    StrokeShape="RoundRectangle 20" 
                    Padding="16">
              <VerticalStackLayout Spacing="12">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                  <Label Text="📜" FontSize="18" VerticalOptions="Center" />
                  <Label Text="{loc:Translate TermsCardTitle}" 
                         FontAttributes="Bold" 
                         TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                         FontSize="15" 
                         VerticalOptions="Center" />
                </HorizontalStackLayout>
                
                <Label Text="{loc:Translate ContactSupportDesc}" 
                       FontSize="12" 
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <!-- Ver Termos -->
                  <Button x:Name="BtnSettingsViewTerms" 
                          Text="{loc:Translate BtnViewTerms}" 
                          Clicked="OnViewTermsClicked" 
                          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                          TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                          BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                          BorderWidth="1.5"
                          FontAttributes="Bold" 
                          CornerRadius="14" 
                          Padding="10,6" 
                          FontSize="13" 
                          HeightRequest="46" />

                  <!-- Enviar Email / Feedback -->
                  <Button x:Name="BtnSettingsContactEmail" 
                          Grid.Column="1" 
                          Text="{loc:Translate BtnContactSupport}" 
                          Clicked="OnContactSupportClicked" 
                          BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                          TextColor="{StaticResource BrandGreen}" 
                          BorderColor="{StaticResource BrandGreen}" 
                          BorderWidth="1.5" 
                          FontAttributes="Bold" 
                          CornerRadius="14" 
                          Padding="10,6" 
                          FontSize="13" 
                          HeightRequest="46" />
                </Grid>
              </VerticalStackLayout>
            </Border>

          </VerticalStackLayout>

          <!-- ========================================== -->
          <!-- SEPARADOR 3: TVs & SALA (EMPARELHAMENTO E CONTROLO) -->
          <!-- ========================================== -->
          <VerticalStackLayout x:Name="AdultTabTvsView" 
                               IsVisible="False" 
                               Spacing="16" 
                               MaximumWidthRequest="700" 
                               HorizontalOptions="Center">

            <!-- CARTÃO DE EMPARELHAMENTO ESPECÍFICO PARA A TV -->
            <Border x:Name="TvServerPairingCard" 
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                    Stroke="{StaticResource BrandGreen}" 
                    StrokeThickness="2" 
                    StrokeShape="RoundRectangle 22" 
                    Padding="24"
                    IsVisible="False">
              <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                  <Label Text="📺" FontSize="26" VerticalOptions="Center" />
                  <Label Text="{loc:Translate TvPairingCardTitle}" 
                         FontAttributes="Bold" 
                         TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                         FontSize="18" />
                </HorizontalStackLayout>

                <Label Text="{loc:Translate TvPairingCardDesc}" 
                       FontSize="13" 
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                       HorizontalTextAlignment="Center" 
                       MaximumWidthRequest="500" />

                <!-- Caixa com Código de Emparelhamento em Tamanho Grande -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                        Stroke="{StaticResource BrandGreen}" 
                        StrokeThickness="2" 
                        StrokeShape="RoundRectangle 18" 
                        Padding="28,12" 
                        HorizontalOptions="Center">
                  <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="{loc:Translate TvCodeLabel}" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light={StaticResource BrandGreenDark}, Dark={StaticResource BrandGreenLight}}" 
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="TvPairingCodeLabel" 
                           Text="--- ---" 
                           FontSize="42" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource BrandGreen}" 
                           HorizontalTextAlignment="Center" 
                           CharacterSpacing="3" />
                    <Label x:Name="TvPairingCountdownLabel" 
                           Text="Válido por 300s" 
                           FontSize="11" 
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                           HorizontalTextAlignment="Center" />
                  </VerticalStackLayout>
                </Border>

                <!-- Botão Gerar Novo Código -->
                <Button x:Name="TvRegenerateCodeBtn" 
                        Text="{loc:Translate BtnGenerateNewCode}" 
                        Clicked="OnRegenerateTvPairingCodeClicked" 
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                        BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        BorderWidth="1.5" 
                        FontAttributes="Bold" 
                        CornerRadius="16" 
                        Padding="16,8" 
                        FontSize="13" 
                        HeightRequest="46" 
                        HorizontalOptions="Center" />

                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="0,4" />

                <!-- Lista de Telemóveis Conectados à TV -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                  <Label x:Name="TvPairedClientsHeaderLabel" 
                         Text="📱 Telemóveis Autorizados" 
                         FontAttributes="Bold" 
                         FontSize="14" 
                         TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                  
                  <CollectionView x:Name="TvPairedClientsList" HeightRequest="120">
                    <CollectionView.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" Padding="10,6" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" Margin="0,2">
                          <Label Text="{Binding DeviceName}" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                          <Label Grid.Column="1" Text="✓ Autorizado" TextColor="{StaticResource BrandGreen}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                      </DataTemplate>
                    </CollectionView.ItemTemplate>
                  </CollectionView>

                  <Button x:Name="TvDisconnectAllBtn" 
                          Text="{loc:Translate BtnDisconnectAllPhones}" 
                          Clicked="OnDisconnectAllTvClientsClicked" 
                          BackgroundColor="{AppThemeBinding Light={StaticResource AccentRedSoft}, Dark=#3B1414}" 
                          TextColor="{StaticResource AccentRed}" 
                          BorderColor="{StaticResource AccentRed}" 
                          BorderWidth="1.5" 
                          FontAttributes="Bold" 
                          CornerRadius="14" 
                          Padding="12,6" 
                          FontSize="12" 
                          HeightRequest="42" 
                          HorizontalOptions="Center" />
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>


            <!-- GESTÃO DE TVs NO TELEMÓVEL (PAIS) -->
            <Border x:Name="MobileTvsManagementCard" 
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                    StrokeThickness="2" 
                    StrokeShape="RoundRectangle 20" 
                    Padding="20">
              <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                  <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="{loc:Translate TvManagementTitle}" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                           FontSize="18" />
                    <Label Text="{loc:Translate TvManagementDesc}" 
                           FontSize="12" 
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                  </VerticalStackLayout>
                  
                  <Button Grid.Column="1" 
                          Text="{loc:Translate BtnAddTv}" 
                          Clicked="OnOpenAddTvModalClicked" 
                          BackgroundColor="{StaticResource BrandGreen}" 
                          TextColor="{StaticResource White}" 
                          FontAttributes="Bold" 
                          CornerRadius="16" 
                          Padding="16,8" 
                          FontSize="13" 
                          HeightRequest="44" />
                </Grid>

                <!-- Dica / Requisito de Emparelhamento -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}"
                        Stroke="{StaticResource BrandGreen}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="12,10">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                    <Label Text="💡" FontSize="18" VerticalOptions="Start" Margin="0,1,0,0" />
                    <Label Grid.Column="1"
                           Text="{loc:Translate TvPairingTip}" 
                           FontSize="12" 
                           TextColor="{AppThemeBinding Light={StaticResource BrandGreenDark}, Dark={StaticResource BrandGreenLight}}" 
                           LineBreakMode="WordWrap" 
                           VerticalOptions="Center" />
                  </Grid>
                </Border>

                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                <!-- Lista de TVs Emparelhadas -->
                <CollectionView x:Name="MobilePairedTvsList" SelectionMode="None">
                  <CollectionView.ItemTemplate>
                    <DataTemplate>
                      <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                              Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                              StrokeThickness="1.5" 
                              StrokeShape="RoundRectangle 16" 
                              Padding="14,12" 
                              Margin="0,0,0,10">
                        <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                          <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                                  StrokeThickness="0" 
                                  StrokeShape="RoundRectangle 14" 
                                  HeightRequest="42" 
                                  WidthRequest="42" 
                                  VerticalOptions="Center">
                            <Label Text="📺" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                          </Border>

                          <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Name}" 
                                   FontAttributes="Bold" 
                                   FontSize="15" 
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <HorizontalStackLayout Spacing="8">
                              <Label Text="{Binding IpAddress}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                              <Label Text="•" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                              <Label Text="{Binding StatusText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding StatusColor}" />
                            </HorizontalStackLayout>
                          </VerticalStackLayout>

                          <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                            <Button Text="🔓 Desbloquear" 
                                    Clicked="OnUnlockRemoteTvClicked" 
                                    CommandParameter="{Binding .}" 
                                    BackgroundColor="{StaticResource BrandGreen}" 
                                    TextColor="{StaticResource White}" 
                                    FontAttributes="Bold" 
                                    CornerRadius="12" 
                                    Padding="8,4" 
                                    FontSize="11" 
                                    HeightRequest="36" />
                            <Button Text="🔄 Sincronizar" 
                                    Clicked="OnSyncSingleTvClicked" 
                                    CommandParameter="{Binding .}" 
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                                    TextColor="{StaticResource BrandGreen}" 
                                    BorderColor="{StaticResource BrandGreen}"
                                    BorderWidth="1.5"
                                    FontAttributes="Bold" 
                                    CornerRadius="12" 
                                    Padding="8,4" 
                                    FontSize="11" 
                                    HeightRequest="36" />
                            <Button Text="▶ Testar" 
                                    Clicked="OnTestTvConnectionClicked" 
                                    CommandParameter="{Binding .}" 
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                                    BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                    BorderWidth="1"
                                    FontAttributes="Bold" 
                                    CornerRadius="12" 
                                    Padding="8,4" 
                                    FontSize="11" 
                                    HeightRequest="36" />
                            <Button Text="✏️" 
                                    Clicked="OnRenameTvClicked" 
                                    CommandParameter="{Binding .}" 
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                                    CornerRadius="12" 
                                    Padding="6,4" 
                                    FontSize="13" 
                                    HeightRequest="36" />
                            <Button Text="🗑️" 
                                    Clicked="OnRemoveTvPairingClicked" 
                                    CommandParameter="{Binding .}" 
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentRedSoft}, Dark=#3B1414}" 
                                    TextColor="{StaticResource AccentRed}" 
                                    CornerRadius="12" 
                                    Padding="6,4" 
                                    FontSize="13" 
                                    HeightRequest="36" />
                          </HorizontalStackLayout>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Mensagem quando não há TVs emparelhadas -->
                <Label x:Name="EmptyMobileTvsHint" 
                       Text="Ainda não tem TVs emparelhadas. Toque em '+ Adicionar TV' para emparelhar com a Android TV ligada à mesma rede Wi-Fi." 
                       FontSize="13" 
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                       HorizontalTextAlignment="Center" 
                       Margin="0,10" 
                       IsVisible="False" />

                <!-- Botão Sincronizar Tudo com a TV -->
                <Button x:Name="SyncAllToTvBtn" 
                        Text="{loc:Translate BtnSyncWithTv}" 
                        Clicked="OnSyncAllWithTvClicked" 
                        BackgroundColor="{StaticResource BrandGreen}" 
                        TextColor="{StaticResource White}" 
                        FontAttributes="Bold" 
                        CornerRadius="16" 
                        Padding="16,8" 
                        FontSize="13" 
                        HeightRequest="46" 
                        HorizontalOptions="Fill" />
                <Label Text="{loc:Translate BtnSyncAllToTvDesc}" 
                       FontSize="11" 
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                       HorizontalTextAlignment="Center" 
                       Margin="0,-4,0,4" />

                <!-- Botão Procurar TVs na Rede -->
                <Button x:Name="ScanTvsNetworkBtn" 
                        Text="{loc:Translate BtnSearchTvs}" 
                        Clicked="OnScanTvsNetworkClicked" 
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                        BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                        BorderWidth="1.5" 
                        FontAttributes="Bold" 
                        CornerRadius="16" 
                        Padding="16,8" 
                        FontSize="13" 
                        HeightRequest="46" 
                        HorizontalOptions="Fill" />
                <ActivityIndicator x:Name="ScanTvsIndicator" IsRunning="False" IsVisible="False" Color="{StaticResource BrandGreen}" HeightRequest="26" />
              </VerticalStackLayout>
            </Border>

          </VerticalStackLayout>

        </Grid>
      </ScrollView>
    </Grid>

    <!-- ========================================== -->
    <!-- 6. MODAL ELEGANTE DE PIN DE ADULTOS (TV FOCUSABLE) -->
    <!-- ========================================== -->
    <Grid x:Name="PinPromptOverlay" Grid.RowSpan="3" Margin="0" IsVisible="False" BackgroundColor="#CC000000">
      <ScrollView VerticalOptions="Center" HorizontalOptions="Fill">
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                StrokeThickness="2" 
                StrokeShape="RoundRectangle 24" 
                Padding="26,24" 
                Margin="24" 
                HorizontalOptions="Center" 
                WidthRequest="380">
          <VerticalStackLayout Spacing="16">
            
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
              <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                        StrokeThickness="0" 
                        StrokeShape="RoundRectangle 20" 
                        HeightRequest="42" 
                        WidthRequest="42" 
                        VerticalOptions="Center">
                  <Label Text="🔒" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                  <Label Text="{loc:Translate PinPromptTitle}" 
                         FontSize="17" 
                         FontAttributes="Bold" 
                         TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                  <Label Text="{loc:Translate PinPromptSubtitle}" 
                         FontSize="12" 
                         TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
              </HorizontalStackLayout>
              
              <Button x:Name="PinCancelBtn"
                      Grid.Column="1" 
                      Text="✕" 
                      Clicked="OnCancelPinPromptClicked" 
                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                      TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                      CornerRadius="18" 
                      WidthRequest="36" 
                      HeightRequest="36" 
                      Padding="0" 
                      FontSize="14" 
                      FontAttributes="Bold" 
                      VerticalOptions="Center" />
            </Grid>

            <!-- Entrada do PIN -->
            <Border x:Name="PinEntryBorder"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                    StrokeThickness="2" 
                    StrokeShape="RoundRectangle 16" 
                    Padding="14,0" 
                    HeightRequest="56" 
                    HorizontalOptions="Fill">
              <Entry x:Name="PinEntryBox" 
                     Placeholder="1234" 
                     TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                     PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                     BackgroundColor="Transparent" 
                     Keyboard="Numeric" 
                     MaxLength="4" 
                     FontSize="26" 
                     FontAttributes="Bold" 
                     HorizontalTextAlignment="Center" 
                     IsPassword="True" 
                     Completed="OnSubmitPinClicked" 
                     TextChanged="OnPinEntryTextChanged" 
                     VerticalOptions="Center" 
                     HorizontalOptions="Fill" />
            </Border>

            <Label x:Name="PinErrorLabel" 
                   Text="{loc:Translate PinErrorIncorrect}" 
                   TextColor="{StaticResource AccentRed}" 
                   FontSize="13" 
                   FontAttributes="Bold" 
                   HorizontalTextAlignment="Center" 
                   IsVisible="False" />

            <!-- Teclado Numérico Focável TV Remote & Mobile -->
            <Grid x:Name="PinKeypadGrid" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,*" RowSpacing="10" ColumnSpacing="10" Margin="0,4,0,0">
              <Button x:Name="PinBtn1" Grid.Row="0" Grid.Column="0" Text="1" Clicked="OnPinKeypadDigitClicked" CommandParameter="1" HeightRequest="52" FontSize="20" FontAttributes="Bold" CornerRadius="14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
              <Button x:Name="PinBtn2" Grid.Row="0" Grid.Column="1" Text="2" Clicked="OnPinKeypadDigitClicked" CommandParameter="2" HeightRequest="52" FontSize="20" FontAttributes="Bold" CornerRadius="14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
              <Button x:Name="PinBtn3" Grid.Row="0" Grid.Column="2" Text="3" Clicked="OnPinKeypadDigitClicked" CommandParameter="3" HeightRequest="52" FontSize="20" FontAttributes="Bold" CornerRadius="14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
              
              <Button x:Name="PinBtn4" Grid.Row="1" Grid.Column="0" Text="4" Clicked="OnPinKeypadDigitClicked" CommandParameter="4" HeightRequest="52" FontSize="20" FontAttributes="Bold" CornerRadius="14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
              <Button x:Name="PinBtn5" Grid.Row="1" Grid.Column="1" Text="5" Clicked="OnPinKeypadDigitClicked" CommandParameter="5" HeightRequest="52" FontSize="20" FontAttributes="Bold" CornerRadius="14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
              <Button x:Name="PinBtn6" Grid.Row="1" Grid.Column="2" Text="6" Clicked="OnPinKeypadDigitClicked" CommandParameter="6" HeightRequest="52" FontSize="20" FontAttributes="Bold" CornerRadius="14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
              
              <Button x:Name="PinBtn7" Grid.Row="2" Grid.Column="0" Text="7" Clicked="OnPinKeypadDigitClicked" CommandParameter="7" HeightRequest="52" FontSize="20" FontAttributes="Bold" CornerRadius="14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
              <Button x:Name="PinBtn8" Grid.Row="2" Grid.Column="1" Text="8" Clicked="OnPinKeypadDigitClicked" CommandParameter="8" HeightRequest="52" FontSize="20" FontAttributes="Bold" CornerRadius="14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
              <Button x:Name="PinBtn9" Grid.Row="2" Grid.Column="2" Text="9" Clicked="OnPinKeypadDigitClicked" CommandParameter="9" HeightRequest="52" FontSize="20" FontAttributes="Bold" CornerRadius="14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
              
              <Button x:Name="PinBtnBack" Grid.Row="3" Grid.Column="0" Text="⌫" Clicked="OnPinKeypadBackspaceClicked" HeightRequest="52" FontSize="18" FontAttributes="Bold" CornerRadius="14" BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
              <Button x:Name="PinBtn0" Grid.Row="3" Grid.Column="1" Text="0" Clicked="OnPinKeypadDigitClicked" CommandParameter="0" HeightRequest="52" FontSize="20" FontAttributes="Bold" CornerRadius="14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
              <Button x:Name="PinBtnSubmit" Grid.Row="3" Grid.Column="2" Text="✓" Clicked="OnSubmitPinClicked" HeightRequest="52" FontSize="18" FontAttributes="Bold" CornerRadius="14" BackgroundColor="{StaticResource BrandGreen}" TextColor="{StaticResource White}" />
            </Grid>

            <!-- Atalho Biométrico -->
            <Button x:Name="TriggerBiometricBtn" 
                    Text="{loc:Translate BtnUseFingerprint}" 
                    Clicked="OnTriggerBiometricClicked" 
                    BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                    TextColor="{AppThemeBinding Light={StaticResource BrandGreenDark}, Dark={StaticResource BrandGreenLight}}" 
                    BorderColor="{AppThemeBinding Light={StaticResource BrandGreen}, Dark={StaticResource BrandGreenLight}}" 
                    BorderWidth="1.5" 
                    FontAttributes="Bold" 
                    CornerRadius="16" 
                    Padding="12,8" 
                    FontSize="14" 
                    HeightRequest="50" 
                    HorizontalOptions="Fill" />

            <!-- Botões Cancelar e Entrar -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
              <Button x:Name="PinPromptCancelBottomBtn"
                      Text="{loc:Translate BtnCancel}" 
                      Clicked="OnCancelPinPromptClicked" 
                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                      TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                      FontAttributes="Bold" 
                      CornerRadius="16" 
                      Padding="12,8" 
                      FontSize="14" 
                      HeightRequest="50" />
              
              <Button x:Name="PinPromptEnterBtn"
                      Grid.Column="1" 
                      Text="{loc:Translate BtnEnter}" 
                      Clicked="OnSubmitPinClicked" 
                      BackgroundColor="{StaticResource BrandGreen}" 
                      TextColor="{StaticResource White}" 
                      FontAttributes="Bold" 
                      CornerRadius="16" 
                      Padding="12,8" 
                      FontSize="14" 
                      HeightRequest="50" />
            </Grid>
          </VerticalStackLayout>
        </Border>
      </ScrollView>
    </Grid>

    <!-- ========================================== -->
    <!-- 6.1 MODAL DE AUTORIZAÇÃO PELO TELEMÓVEL NA TV -->
    <!-- ========================================== -->
    <Grid x:Name="TvRemoteAuthPromptOverlay" Grid.RowSpan="3" Margin="0" IsVisible="False" BackgroundColor="#E6050D1A">
      <ScrollView VerticalOptions="Center" HorizontalOptions="Fill">
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                Stroke="{StaticResource BrandGreen}" 
                StrokeThickness="2" 
                StrokeShape="RoundRectangle 24" 
                Padding="28" 
                Margin="20" 
                HorizontalOptions="Center" 
                WidthRequest="460">
          <VerticalStackLayout Spacing="18" HorizontalOptions="Center">
            
            <Border x:Name="TvSecretIconBorder"
                    BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                    StrokeThickness="0" 
                    StrokeShape="RoundRectangle 24" 
                    HeightRequest="64" 
                    WidthRequest="64" 
                    HorizontalOptions="Center">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSecretEmergencyIconTapped" />
              </Border.GestureRecognizers>
              <Label Text="📱" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
              <Label Text="{loc:Translate TvAuthTitle}" 
                     FontSize="20" 
                     FontAttributes="Bold" 
                     TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                     HorizontalTextAlignment="Center" />
              <Label Text="{loc:Translate TvAuthSubtitle}" 
                     FontSize="14" 
                     TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                     HorizontalTextAlignment="Center" 
                     LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="True" Color="{StaticResource BrandGreen}" HeightRequest="32" HorizontalOptions="Center" />

            <Border x:Name="TvEmergencyBanner" 
                    IsVisible="False" 
                    BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                    StrokeThickness="0" 
                    StrokeShape="RoundRectangle 12" 
                    Padding="12,8" 
                    HorizontalOptions="Center">
              <Label Text="🔑 Desbloqueio de Emergência Disponível" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource BrandGreen}" HorizontalTextAlignment="Center" />
            </Border>

            <!-- Botões de Ação na TV: Usar PIN no Comando ou Cancelar -->
            <VerticalStackLayout Spacing="10" Margin="0,4,0,0" WidthRequest="360">
              <Button x:Name="BtnTvAuthUsePinFallback" 
                      IsVisible="False"
                      Text="{loc:Translate BtnUsePinFallback}" 
                      Clicked="OnTvAuthUsePinFallbackClicked" 
                      BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                      TextColor="{StaticResource BrandGreen}" 
                      BorderColor="{StaticResource BrandGreen}" 
                      BorderWidth="1.5" 
                      FontAttributes="Bold" 
                      CornerRadius="16" 
                      HeightRequest="48" 
                      FontSize="14" />

              <Button x:Name="BtnTvAuthCancel" 
                      Text="{loc:Translate BtnCancel}" 
                      Clicked="OnTvAuthCancelClicked" 
                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                      TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                      FontAttributes="Bold" 
                      CornerRadius="16" 
                      HeightRequest="46" 
                      FontSize="13" />
            </VerticalStackLayout>
          </VerticalStackLayout>
        </Border>
      </ScrollView>
    </Grid>

    <!-- ========================================== -->
    <!-- 7. MODAL DE TERMOS DE UTILIZAÇÃO & PRIVACIDADE (PRIMEIRA EXECUÇÃO / AJUDA) -->
    <!-- ========================================== -->
    <Grid x:Name="TermsOverlay" Grid.RowSpan="3" Margin="0" IsVisible="False" BackgroundColor="#E6050D1A">
      <ScrollView VerticalOptions="Center" HorizontalOptions="Fill">
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                StrokeThickness="2" 
                StrokeShape="RoundRectangle 24" 
                Padding="24" 
                Margin="20" 
                HorizontalOptions="Center" 
                MaximumWidthRequest="640">
          <VerticalStackLayout Spacing="16">
            
            <!-- Cabeçalho do Modal de Termos -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
              <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                        StrokeThickness="0" 
                        StrokeShape="RoundRectangle 20" 
                        HeightRequest="46" 
                        WidthRequest="46" 
                        VerticalOptions="Center">
                  <Label Text="📜" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                  <Label Text="{loc:Translate TermsModalTitle}" 
                         FontSize="18" 
                         FontAttributes="Bold" 
                         TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                  <Label Text="{loc:Translate TermsWelcomeSubtitle}" 
                         FontSize="12" 
                         TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                         LineBreakMode="WordWrap" />
                </VerticalStackLayout>
              </HorizontalStackLayout>

              <!-- Botão Fechar (apenas se já foram aceites anteriormente) -->
              <Button x:Name="TermsCloseBtn"
                      Grid.Column="1" 
                      Text="✕" 
                      Clicked="OnCloseTermsOverlayClicked" 
                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                      TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                      CornerRadius="18" 
                      WidthRequest="36" 
                      HeightRequest="36" 
                      Padding="0" 
                      FontSize="14" 
                      FontAttributes="Bold" 
                      VerticalOptions="Center" />
            </Grid>

            <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

            <!-- Conteúdo dos Termos com Scroll -->
            <ScrollView x:Name="TermsContentScrollView" HeightRequest="320" Scrolled="OnTermsContentScrolled">
              <VerticalStackLayout Spacing="14" Padding="0,4,6,4">
                
                <!-- P1: Ambiente Seguro -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                        StrokeShape="RoundRectangle 14" 
                        StrokeThickness="1" 
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                        Padding="14">
                  <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Translate TermsP1Title}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource BrandGreen}" />
                    <Label Text="{loc:Translate TermsP1Text}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" LineBreakMode="WordWrap" />
                  </VerticalStackLayout>
                </Border>

                <!-- P2: Responsabilidade Parental -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                        StrokeShape="RoundRectangle 14" 
                        StrokeThickness="1" 
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                        Padding="14">
                  <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Translate TermsP2Title}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource BrandGreen}" />
                    <Label Text="{loc:Translate TermsP2Text}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" LineBreakMode="WordWrap" />
                  </VerticalStackLayout>
                </Border>

                <!-- P3: Privacidade e Dados -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                        StrokeShape="RoundRectangle 14" 
                        StrokeThickness="1" 
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                        Padding="14">
                  <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Translate TermsP3Title}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource BrandGreen}" />
                    <Label Text="{loc:Translate TermsP3Text}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" LineBreakMode="WordWrap" />
                  </VerticalStackLayout>
                </Border>

                <!-- P4: YouTube -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                        StrokeShape="RoundRectangle 14" 
                        StrokeThickness="1" 
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                        Padding="14">
                  <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Translate TermsP4Title}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource BrandGreen}" />
                    <Label Text="{loc:Translate TermsP4Text}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" LineBreakMode="WordWrap" />
                  </VerticalStackLayout>
                </Border>

                <!-- P5: Contacto & Suporte -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                        StrokeShape="RoundRectangle 14" 
                        StrokeThickness="1" 
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                        Padding="14">
                  <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Translate TermsP5Title}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource BrandGreen}" />
                    <Label Text="{loc:Translate TermsP5Text}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" LineBreakMode="WordWrap" />
                  </VerticalStackLayout>
                </Border>

              </VerticalStackLayout>
            </ScrollView>

            <!-- Indicador / Instrução de Scroll para Ler -->
            <Label x:Name="TermsScrollHintLabel" 
                   Text="{loc:Translate TermsScrollToBottomHint}" 
                   FontSize="12" 
                   FontAttributes="Bold" 
                   TextColor="#EAB308" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />

            <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

            <!-- Botões de Ação -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <Button x:Name="BtnAcceptTermsOverlay" 
                      Text="{loc:Translate BtnAcceptTerms}" 
                      Clicked="OnAcceptTermsClicked" 
                      BackgroundColor="{StaticResource BrandGreen}" 
                      TextColor="{StaticResource White}" 
                      FontAttributes="Bold" 
                      CornerRadius="16" 
                      HeightRequest="50" 
                      FontSize="14" 
                      HorizontalOptions="Fill" />

              <Button x:Name="BtnTermsContactSupport" 
                      Grid.Column="1" 
                      Text="✉️" 
                      Clicked="OnContactSupportClicked" 
                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                      TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                      BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                      BorderWidth="1.5"
                      FontAttributes="Bold" 
                      CornerRadius="16" 
                      WidthRequest="50" 
                      HeightRequest="50" 
                      Padding="0" 
                      FontSize="18" />
            </Grid>

          </VerticalStackLayout>
        </Border>
      </ScrollView>
    </Grid>

    <!-- ========================================== -->
    <!-- 8. MODAL PARA ADICIONAR / EMPARELHAR TV -->
    <!-- ========================================== -->
    <Grid x:Name="AddTvModalOverlay" Grid.RowSpan="3" Margin="0" IsVisible="False" BackgroundColor="#CC000000">
      <ScrollView VerticalOptions="Center" HorizontalOptions="Fill">
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                StrokeThickness="2" 
                StrokeShape="RoundRectangle 24" 
                Padding="16,20" 
                Margin="16" 
                HorizontalOptions="Center" 
                MaximumWidthRequest="420">
          <VerticalStackLayout Spacing="14">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
              <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                        StrokeThickness="0" 
                        StrokeShape="RoundRectangle 18" 
                        HeightRequest="42" 
                        WidthRequest="42" 
                        VerticalOptions="Center">
                  <Label Text="📺" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                  <Label Text="Adicionar Android TV" 
                         FontSize="16" 
                         FontAttributes="Bold" 
                         TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                  <Label Text="Emparelhamento na rede Wi-Fi" 
                         FontSize="12" 
                         TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
              </HorizontalStackLayout>
              
              <Button Text="✕" 
                      Clicked="OnCloseAddTvModalClicked" 
                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                      TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                      CornerRadius="18" 
                      WidthRequest="36" 
                      HeightRequest="36" 
                      Padding="0" 
                      FontSize="14" 
                      FontAttributes="Bold" 
                      VerticalOptions="Center" />
            </Grid>

            <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

            <!-- Aviso / Dica Importante de Ligação -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}"
                    Stroke="{StaticResource BrandGreen}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,10">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                <Label Text="💡" FontSize="18" VerticalOptions="Start" Margin="0,1,0,0" />
                <Label Grid.Column="1"
                       Text="{loc:Translate TvPairingTip}" 
                       FontSize="11.5" 
                       TextColor="{AppThemeBinding Light={StaticResource BrandGreenDark}, Dark={StaticResource BrandGreenLight}}" 
                       LineBreakMode="WordWrap" 
                       VerticalOptions="Center" />
              </Grid>
            </Border>

            <!-- TVs descobertas na rede -->
            <VerticalStackLayout Spacing="8">
              <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Text="TVs Detetadas na Rede:" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Button Text="🔄 Atualizar" Clicked="OnRefreshDiscoveredTvsClicked" BackgroundColor="Transparent" TextColor="{StaticResource BrandGreen}" FontSize="12" FontAttributes="Bold" Padding="4" HeightRequest="30" />
              </Grid>

              <CollectionView x:Name="DiscoveredTvsModalList" MaximumHeightRequest="140" SelectionMode="Single" SelectionChanged="OnDiscoveredTvSelected">
                <CollectionView.ItemTemplate>
                  <DataTemplate>
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                            StrokeShape="RoundRectangle 12" 
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                            StrokeThickness="1" 
                            Padding="12,10" 
                            Margin="0,0,0,6">
                      <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDiscoveredTvCardTapped" CommandParameter="{Binding .}" />
                      </Border.GestureRecognizers>
                      <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8" VerticalOptions="Center" InputTransparent="True">
                        <Label Text="📺" FontSize="18" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                          <Label Text="{Binding TvName}" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" LineBreakMode="TailTruncation" />
                          <Label Text="{Binding IpAddress}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="Selecionar" FontSize="11" TextColor="{StaticResource BrandGreen}" FontAttributes="Bold" VerticalOptions="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </CollectionView.ItemTemplate>
              </CollectionView>
              <ActivityIndicator x:Name="ModalScanIndicator" IsRunning="False" IsVisible="False" Color="{StaticResource BrandGreen}" HeightRequest="20" />
            </VerticalStackLayout>

            <!-- Formulário de Ligação & Código -->
            <VerticalStackLayout Spacing="10">
              <VerticalStackLayout Spacing="4">
                <Label Text="Endereço IP da TV:" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="46">
                  <Entry x:Name="TvIpEntry" Placeholder="Ex: 192.168.1.67" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" BackgroundColor="Transparent" FontSize="14" VerticalOptions="Center" />
                </Border>
              </VerticalStackLayout>

              <VerticalStackLayout Spacing="4">
                <Label Text="Nome da TV (Ex: Sala, Quarto):" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="46">
                  <Entry x:Name="TvCustomNameEntry" Placeholder="TV da Sala" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" BackgroundColor="Transparent" FontSize="14" VerticalOptions="Center" />
                </Border>
              </VerticalStackLayout>

              <VerticalStackLayout Spacing="4">
                <Label Text="{loc:Translate PairingCodePrompt}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource BrandGreen}" />
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" Stroke="{StaticResource BrandGreen}" StrokeThickness="2" StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="52">
                  <Entry x:Name="TvPairingCodeEntry" Placeholder="583214" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" BackgroundColor="Transparent" Keyboard="Numeric" MaxLength="7" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" CharacterSpacing="2" VerticalOptions="Center" />
                </Border>
              </VerticalStackLayout>
            </VerticalStackLayout>

            <Label x:Name="TvPairingErrorLabel" TextColor="{StaticResource AccentRed}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" IsVisible="False" LineBreakMode="WordWrap" />

            <!-- Botões de Ação -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
              <Button Text="{loc:Translate BtnCancel}" 
                      Clicked="OnCloseAddTvModalClicked" 
                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                      TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                      FontAttributes="Bold" 
                      CornerRadius="14" 
                      HeightRequest="48" 
                      FontSize="13" />
              
              <Button x:Name="BtnConfirmPairTv" 
                      Grid.Column="1" 
                      Text="{loc:Translate BtnPairTv}" 
                      Clicked="OnConfirmPairTvClicked" 
                      BackgroundColor="{StaticResource BrandGreen}" 
                      TextColor="{StaticResource White}" 
                      FontAttributes="Bold" 
                      CornerRadius="14" 
                      HeightRequest="48" 
                      FontSize="13" />
            </Grid>
            <ActivityIndicator x:Name="PairingIndicator" IsRunning="False" IsVisible="False" Color="{StaticResource BrandGreen}" HeightRequest="24" />
          </VerticalStackLayout>
        </Border>
      </ScrollView>
    </Grid>

    <!-- ========================================== -->
    <!-- 9. MODAL PARA ENVIAR VÍDEO(S) PARA A TV -->
    <!-- ========================================== -->
    <Grid x:Name="SendToTvModalOverlay" Grid.RowSpan="3" Margin="0" IsVisible="False" BackgroundColor="#CC000000">
      <ScrollView VerticalOptions="Center" HorizontalOptions="Fill">
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                StrokeThickness="2" 
                StrokeShape="RoundRectangle 24" 
                Padding="16,20" 
                Margin="16" 
                HorizontalOptions="Center" 
                MaximumWidthRequest="420">
          <VerticalStackLayout Spacing="16">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
              <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                        StrokeThickness="0" 
                        StrokeShape="RoundRectangle 18" 
                        HeightRequest="42" 
                        WidthRequest="42" 
                        VerticalOptions="Center">
                  <Label Text="📺" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                  <Label Text="{loc:Translate SelectTvTitle}" 
                         FontSize="17" 
                         FontAttributes="Bold" 
                         TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                  <Label x:Name="SendToTvCountLabel" 
                         Text="1 história selecionada" 
                         FontSize="12" 
                         TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
              </HorizontalStackLayout>
              
              <Button Text="✕" 
                      Clicked="OnCloseSendToTvModalClicked" 
                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                      TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                      CornerRadius="18" 
                      WidthRequest="36" 
                      HeightRequest="36" 
                      Padding="0" 
                      FontSize="14" 
                      FontAttributes="Bold" 
                      VerticalOptions="Center" />
            </Grid>

            <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

            <!-- Seleção da TV -->
            <VerticalStackLayout Spacing="6">
              <Label Text="Escolha a TV:" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
              <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeShape="RoundRectangle 14" Padding="12,0" HeightRequest="48">
                <Picker x:Name="TargetTvPicker" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" TitleColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" FontSize="14" VerticalOptions="Center" />
              </Border>
            </VerticalStackLayout>

            <!-- Ações: Reproduzir Agora ou Adicionar à Fila -->
            <VerticalStackLayout Spacing="10" Margin="0,6,0,0">
              <Button x:Name="BtnSendPlayNow" 
                      Text="{loc:Translate BtnPlayNowTv}" 
                      Clicked="OnSendPlayNowClicked" 
                      BackgroundColor="{StaticResource BrandGreen}" 
                      TextColor="{StaticResource White}" 
                      FontAttributes="Bold" 
                      CornerRadius="16" 
                      HeightRequest="48" 
                      FontSize="14" />

              <Button x:Name="BtnSendAddToQueue" 
                      Text="{loc:Translate BtnAddToQueueTv}" 
                      Clicked="OnSendAddToQueueClicked" 
                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                      TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                      BorderColor="{StaticResource BrandGreen}" 
                      BorderWidth="1.5" 
                      FontAttributes="Bold" 
                      CornerRadius="16" 
                      HeightRequest="48" 
                      FontSize="14" />
            </VerticalStackLayout>

            <Label x:Name="SendToTvStatusLabel" TextColor="{StaticResource BrandGreen}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" IsVisible="False" LineBreakMode="WordWrap" />
            <ActivityIndicator x:Name="SendToTvIndicator" IsRunning="False" IsVisible="False" Color="{StaticResource BrandGreen}" HeightRequest="24" />
          </VerticalStackLayout>
        </Border>
      </ScrollView>
    </Grid>

    <!-- ========================================== -->
    <!-- 10. MODAL DE PRÉ-VISUALIZAÇÃO DE VÍDEO (ADULTOS) -->
    <!-- ========================================== -->
    <Grid x:Name="AdultPreviewModalOverlay" Grid.RowSpan="3" Margin="0" IsVisible="False" BackgroundColor="#E6000000">
      <ScrollView VerticalOptions="Center" HorizontalOptions="Fill">
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                StrokeThickness="2" 
                StrokeShape="RoundRectangle 24" 
                Padding="16,14" 
                Margin="16" 
                HorizontalOptions="Center" 
                VerticalOptions="Center"
                MaximumWidthRequest="620">
          <VerticalStackLayout Spacing="12">
            <!-- Cabeçalho do Preview -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
              <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="🎬" FontSize="20" VerticalOptions="Center" />
                <Label x:Name="PreviewVideoTitleLabel" 
                       Text="{loc:Translate PreviewModalTitle}" 
                       FontSize="15" 
                       FontAttributes="Bold" 
                       LineBreakMode="TailTruncation"
                       MaxLines="1"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                       VerticalOptions="Center" />
              </HorizontalStackLayout>
              
              <Button x:Name="BtnCloseAdultPreviewModal" 
                      Grid.Column="1" 
                      Text="✕" 
                      Clicked="OnCloseAdultPreviewClicked" 
                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                      TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                      CornerRadius="18" 
                      WidthRequest="36" 
                      HeightRequest="36" 
                      Padding="0" 
                      FontSize="14" 
                      FontAttributes="Bold" 
                      VerticalOptions="Center" />
            </Grid>

            <!-- Leitor YouTube no Modal (16:9) -->
            <Border StrokeShape="RoundRectangle 16" 
                    StrokeThickness="1" 
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                    HeightRequest="250" 
                    BackgroundColor="#000000">
              <WebView x:Name="AdultPreviewWebView" HorizontalOptions="Fill" VerticalOptions="Fill" />
            </Border>

            <!-- Barra de Ações Rápidas do Adulto -->
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
              <!-- Botão Aprovar/Remover para Crianças -->
              <Button x:Name="BtnPreviewToggleApproval" 
                      Grid.Column="0" 
                      Text="{loc:Translate BtnApproveForKids}" 
                      Clicked="OnPreviewToggleApprovalClicked" 
                      BackgroundColor="{StaticResource BrandGreen}" 
                      TextColor="{StaticResource White}" 
                      FontAttributes="Bold" 
                      CornerRadius="14" 
                      HeightRequest="44" 
                      FontSize="12" />

              <!-- Botão Bloquear / Ocultar dos Temas -->
              <Button x:Name="BtnPreviewBlockVideo" 
                      Grid.Column="1" 
                      Text="{loc:Translate BtnBlockVideo}" 
                      Clicked="OnPreviewBlockVideoClicked" 
                      BackgroundColor="#EF4444" 
                      TextColor="{StaticResource White}" 
                      FontAttributes="Bold" 
                      CornerRadius="14" 
                      HeightRequest="44" 
                      FontSize="12" />

              <!-- Botão Enviar para TV -->
              <Button x:Name="BtnPreviewSendToTv" 
                      Grid.Column="2" 
                      Text="📺" 
                      Clicked="OnPreviewSendToTvClicked" 
                      BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                      TextColor="{StaticResource BrandGreen}" 
                      BorderColor="{StaticResource BrandGreen}"
                      BorderWidth="1.5"
                      CornerRadius="14" 
                      WidthRequest="44"
                      HeightRequest="44" 
                      Padding="0"
                      FontSize="16" />
            </Grid>
          </VerticalStackLayout>
        </Border>
      </ScrollView>
    </Grid>

    <!-- ========================================== -->
    <!-- 10. MODAL DE APRESENTAÇÃO / ONBOARDING / TUTORIAL -->
    <!-- ========================================== -->
    <Grid x:Name="OnboardingModalOverlay" 
          Grid.RowSpan="3" 
          Margin="0" 
          IsVisible="False" 
          BackgroundColor="#EE060D17">
      <ScrollView VerticalOptions="Center" HorizontalOptions="Fill">
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                StrokeThickness="2" 
                StrokeShape="RoundRectangle 28" 
                Padding="20,22" 
                Margin="16,20" 
                HorizontalOptions="Center" 
                MaximumWidthRequest="520">
          <VerticalStackLayout Spacing="16">
            
            <!-- TOPO: BADGE, CONTADOR DE PASSOS & SALTAR -->
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
              <!-- Badge da App -->
              <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                      StrokeThickness="0" 
                      StrokeShape="RoundRectangle 12" 
                      Padding="8,4" 
                      VerticalOptions="Center">
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                  <Label Text="🐥" FontSize="14" VerticalOptions="Center" />
                  <Label Text="yChicaTube" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource BrandGreen}" VerticalOptions="Center" />
                </HorizontalStackLayout>
              </Border>

              <!-- Contador de Passos (Passo 1 de 5) -->
              <Label x:Name="OnboardingStepLabel" 
                     Grid.Column="1" 
                     Text="Passo 1 de 5" 
                     FontSize="12" 
                     FontAttributes="Bold" 
                     TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                     HorizontalOptions="Center" 
                     VerticalOptions="Center" />

              <!-- Botão Saltar -->
              <Button x:Name="BtnSkipOnboarding" 
                      Grid.Column="2" 
                      Text="{loc:Translate OnboardingSkip}" 
                      Clicked="OnSkipOnboardingClicked" 
                      BackgroundColor="Transparent" 
                      TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                      FontSize="12" 
                      FontAttributes="Bold" 
                      Padding="8,4" 
                      HeightRequest="36" 
                      VerticalOptions="Center" />
            </Grid>

            <!-- CONTEÚDO DO SLIDE -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 20" 
                    Padding="16,18">
              <VerticalStackLayout Spacing="12">
                
                <!-- Ícone Hero do Slide -->
                <Border x:Name="OnboardingIconBorder" 
                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                        StrokeThickness="0" 
                        StrokeShape="RoundRectangle 26" 
                        HeightRequest="56" 
                        WidthRequest="56" 
                        HorizontalOptions="Center">
                  <Label x:Name="OnboardingSlideIcon" 
                         Text="🐥" 
                         FontSize="30" 
                         HorizontalOptions="Center" 
                         VerticalOptions="Center" />
                </Border>

                <!-- Título e Subtítulo -->
                <VerticalStackLayout Spacing="4">
                  <Label x:Name="OnboardingSlideTitle" 
                         Text="Bem-vindo ao yChicaTube!" 
                         FontSize="17" 
                         FontAttributes="Bold" 
                         TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                         HorizontalTextAlignment="Center" />
                  <Label x:Name="OnboardingSlideSubtitle" 
                         Text="Um espaço digital seguro, lúdico e sem distrações para crianças." 
                         FontSize="12" 
                         TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                         HorizontalTextAlignment="Center" 
                         LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- Imagem / Print Ilustrativo do Slide -->
                <Border x:Name="OnboardingImageBorder"
                        StrokeShape="RoundRectangle 16" 
                        StrokeThickness="1" 
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}"
                        HorizontalOptions="Center" 
                        Margin="0,2,0,2">
                  <Image x:Name="OnboardingSlideImage" 
                         Aspect="AspectFit" 
                         HeightRequest="150" 
                         MaximumWidthRequest="440"
                         HorizontalOptions="Center" />
                </Border>

                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="0,4" />

                <!-- 3 Cartões com Destaques -->
                <VerticalStackLayout Spacing="8">
                  <!-- Destaque 1 -->
                  <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                          StrokeShape="RoundRectangle 12" 
                          StrokeThickness="1" 
                          Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                          Padding="10,8">
                    <Label x:Name="OnboardingBullet1" 
                           FontSize="12" 
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                           LineBreakMode="WordWrap" />
                  </Border>

                  <!-- Destaque 2 -->
                  <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                          StrokeShape="RoundRectangle 12" 
                          StrokeThickness="1" 
                          Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                          Padding="10,8">
                    <Label x:Name="OnboardingBullet2" 
                           FontSize="12" 
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                           LineBreakMode="WordWrap" />
                  </Border>

                  <!-- Destaque 3 -->
                  <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
                          StrokeShape="RoundRectangle 12" 
                          StrokeThickness="1" 
                          Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                          Padding="10,8">
                    <Label x:Name="OnboardingBullet3" 
                           FontSize="12" 
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                           LineBreakMode="WordWrap" />
                  </Border>
                </VerticalStackLayout>

              </VerticalStackLayout>
            </Border>

            <!-- PONTOS DE PROGRESSO (DOTS) -->
            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,2">
              <BoxView x:Name="OnboardingDot1" CornerRadius="4" HeightRequest="8" WidthRequest="24" BackgroundColor="{StaticResource BrandGreen}" />
              <BoxView x:Name="OnboardingDot2" CornerRadius="4" HeightRequest="8" WidthRequest="8" BackgroundColor="#8094A3B8" />
              <BoxView x:Name="OnboardingDot3" CornerRadius="4" HeightRequest="8" WidthRequest="8" BackgroundColor="#8094A3B8" />
              <BoxView x:Name="OnboardingDot4" CornerRadius="4" HeightRequest="8" WidthRequest="8" BackgroundColor="#8094A3B8" />
              <BoxView x:Name="OnboardingDot5" CornerRadius="4" HeightRequest="8" WidthRequest="8" BackgroundColor="#8094A3B8" />
            </HorizontalStackLayout>

            <!-- BOTÕES DE NAVEGAÇÃO -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <!-- Anterior -->
              <Button x:Name="BtnOnboardingPrev" 
                      Text="{loc:Translate OnboardingPrev}" 
                      Clicked="OnOnboardingPrevClicked" 
                      IsVisible="False" 
                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                      TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                      BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                      BorderWidth="1.5" 
                      FontAttributes="Bold" 
                      CornerRadius="16" 
                      HeightRequest="48" 
                      FontSize="13" />

              <!-- Seguinte / Começar -->
              <Button x:Name="BtnOnboardingNext" 
                      Grid.Column="1" 
                      Text="{loc:Translate OnboardingNext}" 
                      Clicked="OnOnboardingNextClicked" 
                      BackgroundColor="{StaticResource BrandGreen}" 
                      TextColor="{StaticResource White}" 
                      FontAttributes="Bold" 
                      CornerRadius="16" 
                      HeightRequest="48" 
                      FontSize="13" 
                      HorizontalOptions="Fill" />
            </Grid>

          </VerticalStackLayout>
        </Border>
      </ScrollView>
    </Grid>

    <!-- ========================================== -->
    <!-- 9. MODAL DE INSPEÇÃO & TESTE DE PLAYLIST -->
    <!-- ========================================== -->
    <Grid x:Name="PlaylistInspectModalOverlay" Grid.RowSpan="3" Margin="0" IsVisible="False" BackgroundColor="#DD000000">
      <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBgLight}, Dark={StaticResource SurfaceBgDark}}" 
              Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
              StrokeThickness="2" 
              StrokeShape="RoundRectangle 24" 
              Padding="18,20" 
              Margin="16,24" 
              HorizontalOptions="Center" 
              VerticalOptions="Center"
              MaximumWidthRequest="560"
              MaximumHeightRequest="680">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
          
          <!-- 1. Cabeçalho da Playlist com Thumbnail, Título e Botão Fechar -->
          <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" WidthRequest="70" HeightRequest="50" VerticalOptions="Center">
              <Image x:Name="PlaylistInspectThumb" Aspect="AspectFill" />
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
              <Label x:Name="PlaylistInspectTitleLabel" 
                     Text="Nome da Playlist" 
                     FontSize="15" 
                     FontAttributes="Bold" 
                     TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                     LineBreakMode="TailTruncation" 
                     MaxLines="2" />
              <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Label x:Name="PlaylistInspectChannelLabel" 
                       Text="Canal Oficial" 
                       FontSize="11.5" 
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <Label Text="•" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <Label x:Name="PlaylistInspectCountLabel" 
                       Text="25 vídeos" 
                       FontSize="11.5" 
                       FontAttributes="Bold" 
                       TextColor="{StaticResource BrandGreen}" />
              </HorizontalStackLayout>
            </VerticalStackLayout>

            <Button x:Name="BtnClosePlaylistInspectTop"
                    Grid.Column="2" 
                    Text="✕" 
                    Clicked="OnClosePlaylistInspectModalClicked" 
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                    CornerRadius="18" 
                    WidthRequest="36" 
                    HeightRequest="36" 
                    Padding="0" 
                    FontSize="14" 
                    FontAttributes="Bold" 
                    VerticalOptions="Center" />
          </Grid>

          <!-- 2. Botão Principal de Aprovação / Desaprovação da Playlist Inteira -->
          <Border Grid.Row="1" 
                  BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                  Stroke="{StaticResource BrandGreen}" 
                  StrokeThickness="1" 
                  StrokeShape="RoundRectangle 16" 
                  Padding="14,12">
            <VerticalStackLayout Spacing="8">
              <Button x:Name="BtnToggleApproveFullPlaylist" 
                      Text="{loc:Translate BtnApproveFullPlaylist}" 
                      Clicked="OnToggleApproveFullPlaylistClicked" 
                      BackgroundColor="{StaticResource BrandGreen}" 
                      TextColor="{StaticResource White}" 
                      FontAttributes="Bold" 
                      CornerRadius="14" 
                      HeightRequest="46" 
                      FontSize="14" 
                      HorizontalOptions="Fill" />
              <Label Text="💡 Ao aprovar a playlist, todos os seus episódios ficam autorizados e misturados de forma mágica e variada para a criança." 
                     FontSize="11.5" 
                     TextColor="{AppThemeBinding Light={StaticResource BrandGreenDark}, Dark={StaticResource BrandGreenLight}}" 
                     LineBreakMode="WordWrap" />
            </VerticalStackLayout>
          </Border>

          <!-- 3. Lista de Vídeos / Episódios da Playlist com Botão Testar Áudio -->
          <VerticalStackLayout Grid.Row="2" Spacing="6">
            <Label Text="🎬 Episódios da Playlist (Toque em '▶ Testar Áudio' para ouvir):" 
                   FontSize="12" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            
            <ActivityIndicator x:Name="PlaylistInspectIndicator" IsRunning="False" IsVisible="False" Color="{StaticResource BrandGreen}" HeightRequest="30" />

            <CollectionView x:Name="PlaylistInspectVideosList" SelectionMode="None">
              <CollectionView.ItemTemplate>
                <DataTemplate>
                  <Border StrokeShape="RoundRectangle 14" 
                          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                          Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                          StrokeThickness="1" 
                          Padding="10,8" 
                          Margin="0,0,0,8">
                    <Grid ColumnDefinitions="58,*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                      <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="58" HeightRequest="38" VerticalOptions="Center">
                        <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill" />
                      </Border>
                      <Label Grid.Column="1" 
                             Text="{Binding Title}" 
                             FontSize="12.5" 
                             FontAttributes="Bold" 
                             TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                             LineBreakMode="TailTruncation" 
                             MaxLines="2" 
                             VerticalOptions="Center" />
                      
                      <!-- Botão Testar Áudio -->
                      <Button Grid.Column="2" 
                              Text="{loc:Translate BtnTestAudio}" 
                              Clicked="OnTestPlaylistVideoAudioClicked" 
                              CommandParameter="{Binding .}" 
                              BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" 
                              TextColor="{StaticResource BrandGreen}" 
                              BorderColor="{StaticResource BrandGreen}" 
                              BorderWidth="1.5" 
                              CornerRadius="12" 
                              HeightRequest="34" 
                              Padding="10,0" 
                              FontSize="11.5" 
                              FontAttributes="Bold" 
                              VerticalOptions="Center" />

                      <!-- Botão Ocultar Vídeo Individual -->
                      <Button Grid.Column="3" 
                              Text="🚫" 
                              Clicked="OnBlockPlaylistVideoClicked" 
                              CommandParameter="{Binding .}" 
                              BackgroundColor="{AppThemeBinding Light=#1AEF4444, Dark=#33EF4444}" 
                              TextColor="#EF4444" 
                              BorderColor="#EF4444" 
                              BorderWidth="1" 
                              CornerRadius="12" 
                              HeightRequest="34" 
                              WidthRequest="34" 
                              Padding="0" 
                              FontSize="13" 
                              FontAttributes="Bold" 
                              VerticalOptions="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </CollectionView.ItemTemplate>
            </CollectionView>
          </VerticalStackLayout>

          <!-- 4. Rodapé Fechar -->
          <Button x:Name="BtnClosePlaylistInspectBottom"
                  Grid.Row="3" 
                  Text="{loc:Translate BtnOk}" 
                  Clicked="OnClosePlaylistInspectModalClicked" 
                  BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" 
                  TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" 
                  BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                  BorderWidth="1.5" 
                  FontAttributes="Bold" 
                  CornerRadius="16" 
                  HeightRequest="44" 
                  FontSize="13" 
                  HorizontalOptions="Fill" />
        </Grid>
      </Border>
    </Grid>

    <!-- ========================================== -->
    <!-- 9. SPLASH SCREEN ANIMADO PARA CRIANÇAS     -->
    <!-- ========================================== -->
    <Grid x:Name="AnimatedSplashOverlay" 
          Grid.RowSpan="3" 
          Margin="0" 
          IsVisible="True" 
          ZIndex="99999"
          BackgroundColor="#090E17">
      
      <!-- Fundo com gradiente mágico suave -->
      <BoxView HorizontalOptions="Fill" VerticalOptions="Fill">
        <BoxView.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#064E3B" Offset="0.0" />
            <GradientStop Color="#09131C" Offset="0.35" />
            <GradientStop Color="#0F172A" Offset="0.75" />
            <GradientStop Color="#1E1B4B" Offset="1.0" />
          </LinearGradientBrush>
        </BoxView.Background>
      </BoxView>

      <!-- Partículas e Estrelas Mágicas Flutuantes -->
      <Label x:Name="SplashStar1" Text="✨" FontSize="30" TextColor="#FDE047" TranslationX="-130" TranslationY="-170" Opacity="0" HorizontalOptions="Center" VerticalOptions="Center" />
      <Label x:Name="SplashStar2" Text="⭐" FontSize="38" TextColor="#F59E0B" TranslationX="140" TranslationY="-120" Opacity="0" HorizontalOptions="Center" VerticalOptions="Center" />
      <Label x:Name="SplashStar3" Text="🌟" FontSize="32" TextColor="#60A5FA" TranslationX="-150" TranslationY="130" Opacity="0" HorizontalOptions="Center" VerticalOptions="Center" />
      <Label x:Name="SplashStar4" Text="🎈" FontSize="34" TranslationX="130" TranslationY="160" Opacity="0" HorizontalOptions="Center" VerticalOptions="Center" />
      <Label x:Name="SplashStar5" Text="🌈" FontSize="34" TranslationX="0" TranslationY="-210" Opacity="0" HorizontalOptions="Center" VerticalOptions="Center" />
      <Label x:Name="SplashStar6" Text="💫" FontSize="28" TextColor="#A78BFA" TranslationX="-110" TranslationY="190" Opacity="0" HorizontalOptions="Center" VerticalOptions="Center" />

      <!-- Conteúdo Central -->
      <VerticalStackLayout Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
        
        <!-- Mascote com Efeito Glow e Salto -->
        <Grid HorizontalOptions="Center" VerticalOptions="Center">
          <!-- Glow Circle atrás do Mascote -->
          <Border x:Name="SplashGlowCircle"
                  WidthRequest="140"
                  HeightRequest="140"
                  StrokeShape="RoundRectangle 70"
                  StrokeThickness="0"
                  BackgroundColor="#10B981"
                  Opacity="0.2"
                  Scale="0.8"
                  HorizontalOptions="Center"
                  VerticalOptions="Center" />

          <!-- Card do Mascote -->
          <Border x:Name="SplashMascotCard"
                  WidthRequest="116"
                  HeightRequest="116"
                  StrokeShape="RoundRectangle 58"
                  Stroke="{StaticResource BrandGreen}"
                  StrokeThickness="3.5"
                  BackgroundColor="#064E3B"
                  Scale="0.3"
                  Opacity="0"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
            <Border.Shadow>
              <Shadow Brush="#10B981" Offset="0,8" Radius="28" Opacity="0.65" />
            </Border.Shadow>
            <Grid>
              <Label x:Name="SplashMascotEmoji" Text="🐥" FontSize="62" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
          </Border>
        </Grid>

        <!-- Título do App Animado -->
        <HorizontalStackLayout x:Name="SplashTitleLayout" Spacing="0" HorizontalOptions="Center" Opacity="0" TranslationY="20">
          <Label Text="yChica" 
                 FontSize="38" 
                 FontAttributes="Bold" 
                 TextColor="{StaticResource BrandGreenLight}" 
                 VerticalOptions="Center" />
          <Label Text="Tube" 
                 FontSize="38" 
                 FontAttributes="Bold" 
                 TextColor="#FFFFFF" 
                 VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Subtítulo e Mensagem Divertida -->
        <Label x:Name="SplashTagline" 
               Text="{loc:Translate AppSubtitle}" 
               FontSize="16" 
               FontAttributes="Bold" 
               TextColor="#94A3B8" 
               HorizontalOptions="Center" 
               Opacity="0" 
               TranslationY="15" />

        <!-- Barra / Indicador Divertido de Carregamento -->
        <Border x:Name="SplashLoadingPill"
                StrokeShape="RoundRectangle 18"
                BackgroundColor="#1E293B"
                Stroke="#334155"
                StrokeThickness="1"
                Padding="18,9"
                Margin="0,10,0,0"
                Opacity="0"
                HorizontalOptions="Center">
          <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
            <ActivityIndicator IsRunning="True" Color="{StaticResource BrandGreen}" WidthRequest="20" HeightRequest="20" />
            <Label Text="{loc:Translate SplashLoadingText}" FontSize="13" TextColor="#E2E8F0" FontAttributes="Bold" VerticalOptions="Center" />
          </HorizontalStackLayout>
        </Border>
      </VerticalStackLayout>

      <!-- Gesture Recognizer para saltar ao tocar -->
      <Grid.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnSplashTapped" />
      </Grid.GestureRecognizers>
    </Grid>

  </Grid>
</ContentPage>
